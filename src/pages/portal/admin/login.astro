---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';

const errorParam = Astro.url.searchParams.get('error');
const retryAfterParam = Astro.url.searchParams.get('retry_after');

let errorMessage: string | null = null;
if (errorParam === 'rate_limited') {
  const retryAfter = Number.isFinite(Number(retryAfterParam))
    ? Number(retryAfterParam)
    : 60;
  errorMessage = `Terlalu banyak percobaan. Silakan tunggu ${retryAfter} detik dan coba lagi.`;
} else if (errorParam === 'turnstile') {
  errorMessage = 'Verifikasi keamanan gagal. Coba refresh halaman ini dan login ulang.';
} else if (errorParam === 'credentials') {
  errorMessage = 'Email atau password salah. Silakan coba lagi.';
} else if (errorParam === 'unauthorized') {
  errorMessage = 'Akun Anda tidak memiliki akses admin. Hubungi administrator.';
} else if (errorParam) {
  errorMessage = 'Gagal masuk. Silakan coba lagi.';
}

const signedOut = Astro.url.searchParams.get('signed_out') === '1';

const turnstileSiteKey =
  typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === 'string'
    ? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
    : '';
---

<BaseLayout
  title="Admin Portal — ABSENKOK"
  description="Masuk ke admin portal ABSENKOK untuk mengelola skor tier dan leaderboard."
>
  <div class="min-h-screen bg-slate-50 flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-5xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/70">
      <div class="grid lg:grid-cols-[0.95fr_1.05fr]">
        <section class="hidden bg-slate-950 p-10 text-white lg:flex lg:flex-col lg:justify-between">
          <div>
            <a href="/" class="inline-flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-white text-slate-950">
                <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                  <path d="M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="text-2xl font-extrabold tracking-tight">
                <span class="text-[#FF4DA0]">ABSEN</span><span class="text-[#7C8DFF]">KOK</span>
              </span>
            </a>
            <h1 class="mt-12 max-w-sm text-4xl font-extrabold leading-tight tracking-tight">
              Admin dashboard untuk skor tier.
            </h1>
            <p class="mt-4 max-w-sm text-sm leading-6 text-slate-400">
              Akses aman untuk memantau tier, leaderboard, dan penilaian karyawan.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <svg class="mb-3 h-5 w-5 text-[#7C8DFF]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M7 16h10M8.5 12h7M10 8h4M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="text-xs font-semibold text-slate-400">Tier</div>
              <div class="mt-1 text-sm font-bold">SSS-F</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <svg class="mb-3 h-5 w-5 text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M8 18V9m4 9V5m4 13v-6M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="text-xs font-semibold text-slate-400">Data</div>
              <div class="mt-1 text-sm font-bold">Realtime</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4">
              <svg class="mb-3 h-5 w-5 text-emerald-300" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M9 12l2 2 4-5M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div class="text-xs font-semibold text-slate-400">Mode</div>
              <div class="mt-1 text-sm font-bold">Secure</div>
            </div>
          </div>
        </section>

        <section class="px-6 py-8 sm:px-10 lg:py-12">
          <div class="mb-8 lg:hidden">
            <a href="/" class="inline-flex items-center gap-2">
              <span class="text-2xl font-extrabold tracking-tight">
                <span class="text-[#FF4DA0]">ABSEN</span><span class="text-[#7C8DFF]">KOK</span>
              </span>
            </a>
          </div>

          <div class="mb-8">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#7C8DFF]">Admin Portal</p>
            <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">Masuk ke dashboard</h2>
            <p class="mt-2 text-sm text-slate-500">Gunakan email dan password admin Anda.</p>
          </div>

        {signedOut && (
          <div class="mb-5 flex gap-3 rounded-2xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800" role="status">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Anda telah keluar dari Admin Portal.</span>
          </div>
        )}

        {errorMessage && (
          <div class="mb-5 flex gap-3 rounded-2xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700" role="alert">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 8v5M12 17h.01M10.3 4.3 2.9 18a1.5 1.5 0 0 0 1.32 2.2h15.56A1.5 1.5 0 0 0 21.1 18L13.7 4.3a1.95 1.95 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{errorMessage}</span>
          </div>
        )}

        <form
          method="POST"
          action="/portal/admin/auth/sign-in"
          id="admin-login-form"
          novalidate
        >
          <div class="mb-4">
            <label for="email" class="mb-1.5 flex items-center gap-2 text-sm font-semibold text-slate-700">
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M4 6h16v12H4V6Zm1.5 1.5 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="admin@absenkok.app"
              class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 shadow-sm focus:border-[#7C8DFF] focus:outline-none focus:ring-2 focus:ring-[#7C8DFF]/20 transition"
            />
          </div>

          <div class="mb-4">
            <label for="password" class="mb-1.5 flex items-center gap-2 text-sm font-semibold text-slate-700">
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Masukkan password"
              class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 shadow-sm focus:border-[#7C8DFF] focus:outline-none focus:ring-2 focus:ring-[#7C8DFF]/20 transition"
            />
          </div>

          {turnstileSiteKey && (
            <div class="mb-4 flex justify-center">
              <div
                id="turnstile-widget"
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="light"
                data-size="flexible"
              ></div>
            </div>
          )}

          <button
            type="submit"
            id="submit-btn"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900/40 transition disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 5l7 7-7 7M19 12H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span id="btn-text">Masuk</span>
            <span id="btn-loading" class="hidden">Memproses...</span>
          </button>
        </form>

        {turnstileSiteKey && (
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          ></script>
        )}

        <div class="mt-6 text-center">
          <a href="/portal/login" class="inline-flex items-center justify-center gap-2 text-sm font-medium text-slate-500 hover:text-[#FF4DA0] transition">
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 19l-7-7 7-7M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Kembali ke Portal Karyawan
          </a>
        </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && submitBtn) {
    form.addEventListener('submit', () => {
      const btnText = document.getElementById('btn-text');
      const btnLoading = document.getElementById('btn-loading');
      if (btnText) btnText.classList.add('hidden');
      if (btnLoading) btnLoading.classList.remove('hidden');
      submitBtn.disabled = true;
    });
  }
</script>
