---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';

const errorParam = Astro.url.searchParams.get('error');
const retryAfterParam = Astro.url.searchParams.get('retry_after');

let errorMessage: string | null = null;
if (errorParam === 'rate_limited') {
  const retryAfter = Number.isFinite(Number(retryAfterParam))
    ? Number(retryAfterParam)
    : 60;
  errorMessage = `Terlalu banyak percobaan. Silakan tunggu ${retryAfter} detik dan coba lagi.`;
} else if (errorParam === 'turnstile') {
  errorMessage = 'Verifikasi keamanan gagal. Coba refresh halaman ini dan login ulang.';
} else if (errorParam === 'credentials') {
  errorMessage = 'Email atau password salah. Silakan coba lagi.';
} else if (errorParam === 'unauthorized') {
  errorMessage = 'Akun Anda tidak memiliki akses admin. Hubungi administrator.';
} else if (errorParam) {
  errorMessage = 'Gagal masuk. Silakan coba lagi.';
}

const signedOut = Astro.url.searchParams.get('signed_out') === '1';

const turnstileSiteKey =
  typeof import.meta.env.PUBLIC_TURNSTILE_SITE_KEY === 'string'
    ? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
    : '';
---

<BaseLayout
  title="Admin Portal — ABSENKOK"
  description="Masuk ke admin portal ABSENKOK untuk mengelola skor tier dan leaderboard."
>
  <div class="admin-arena-bg relative min-h-screen overflow-hidden px-4 py-10 text-slate-100 sm:px-6 lg:px-8">
    <div class="pointer-events-none absolute inset-0 arena-grid-bg opacity-70"></div>
    <div class="pointer-events-none absolute -left-24 top-20 h-80 w-80 rounded-full bg-[#FF4DA0]/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 bottom-24 h-96 w-96 rounded-full bg-[#7C8DFF]/20 blur-3xl"></div>

    <div class="relative z-10 mx-auto grid min-h-[calc(100vh-5rem)] w-full max-w-6xl items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <section class="hidden lg:block">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.28em] text-cyan-100">
          <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M9 12l2 2 4-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Secure Command Center
        </div>
        <h1 class="max-w-2xl text-5xl font-black leading-[0.95] tracking-tight text-white xl:text-6xl">
          Arena kontrol untuk performa tim.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-slate-300">
          Pantau skor tier, leaderboard, dan sinyal operasional melalui admin portal ABSENKOK yang aman.
        </p>
        <div class="mt-8 grid max-w-xl grid-cols-3 gap-3">
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-black/20 backdrop-blur">
            <svg class="mb-3 h-6 w-6 text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M7 16h10M8.5 12h7M10 8h4M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Mode</div>
            <div class="mt-1 text-sm font-extrabold text-white">Admin</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-black/20 backdrop-blur">
            <svg class="mb-3 h-6 w-6 text-[#7C8DFF]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M8 18V9m4 9V5m4 13v-6M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Signal</div>
            <div class="mt-1 text-sm font-extrabold text-white">Realtime</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-black/20 backdrop-blur">
            <svg class="mb-3 h-6 w-6 text-amber-300" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 4l2.2 4.46 4.92.72-3.56 3.47.84 4.9L12 15.23l-4.4 2.32.84-4.9-3.56-3.47 4.92-.72L12 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <div class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Tier</div>
            <div class="mt-1 text-sm font-extrabold text-white">SSS-F</div>
          </div>
        </div>
      </section>

      <div class="mx-auto w-full max-w-md">
        <div class="mb-7 text-center lg:text-left">
          <a href="/" class="inline-flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-2xl border border-[#7C8DFF]/40 bg-[#7C8DFF]/15 shadow-[0_0_32px_rgba(124,141,255,0.26)]">
              <svg class="h-5 w-5 text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M12 3l2.35 5.05 5.52.7-4.08 3.72 1.08 5.46L12 15.16 7.13 17.93l1.08-5.46-4.08-3.72 5.52-.7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-2xl font-extrabold tracking-tight">
              <span class="text-[#FF4DA0]">ABSEN</span><span class="text-[#7C8DFF]">KOK</span>
            </span>
          </a>
          <h2 class="mt-7 text-3xl font-black tracking-tight text-white">Admin Portal</h2>
          <p class="mt-2 text-sm text-slate-400">Masuk dengan kredensial admin untuk membuka command center.</p>
        </div>

        <div class="rounded-[2rem] border border-white/10 bg-slate-950/75 p-6 shadow-[0_28px_80px_rgba(0,0,0,0.45)] backdrop-blur-xl sm:p-8">

        {signedOut && (
          <div class="mb-5 flex gap-3 rounded-2xl border border-emerald-400/30 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-100" role="status">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Anda telah keluar dari Admin Portal.</span>
          </div>
        )}

        {errorMessage && (
          <div class="mb-5 flex gap-3 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-100" role="alert">
            <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 8v5M12 17h.01M10.3 4.3 2.9 18a1.5 1.5 0 0 0 1.32 2.2h15.56A1.5 1.5 0 0 0 21.1 18L13.7 4.3a1.95 1.95 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{errorMessage}</span>
          </div>
        )}

        <form
          method="POST"
          action="/portal/admin/auth/sign-in"
          id="admin-login-form"
          novalidate
        >
          <div class="mb-4">
            <label for="email" class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
              <svg class="h-4 w-4 text-[#7C8DFF]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M4 6h16v12H4V6Zm1.5 1.5 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="admin@absenkok.app"
              class="block w-full rounded-2xl border border-white/10 bg-white/[0.07] px-4 py-3 text-sm font-medium text-white placeholder-slate-500 shadow-inner shadow-black/20 transition focus:border-[#7C8DFF]/70 focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/15"
            />
          </div>

          <div class="mb-4">
            <label for="password" class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
              <svg class="h-4 w-4 text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M7 11V8a5 5 0 0 1 10 0v3M6 11h12v9H6v-9Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Masukkan password"
              class="block w-full rounded-2xl border border-white/10 bg-white/[0.07] px-4 py-3 text-sm font-medium text-white placeholder-slate-500 shadow-inner shadow-black/20 transition focus:border-[#FF4DA0]/70 focus:outline-none focus:ring-4 focus:ring-[#FF4DA0]/15"
            />
          </div>

          {turnstileSiteKey && (
            <div class="mb-4 flex justify-center">
              <div
                id="turnstile-widget"
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="dark"
                data-size="flexible"
              ></div>
            </div>
          )}

          <button
            type="submit"
            id="submit-btn"
            class="group mt-2 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-[#FF4DA0] via-[#7C8DFF] to-cyan-400 px-4 py-3 text-sm font-black uppercase tracking-[0.18em] text-white shadow-[0_18px_44px_rgba(124,141,255,0.35)] transition hover:scale-[1.01] focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/35 disabled:cursor-not-allowed disabled:opacity-40"
          >
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 5l7 7-7 7M19 12H5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span id="btn-text">Masuk</span>
            <span id="btn-loading" class="hidden">Memproses...</span>
          </button>
        </form>

        {turnstileSiteKey && (
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          ></script>
        )}

        <div class="mt-6 text-center">
          <a href="/portal/login" class="inline-flex items-center justify-center gap-2 text-sm font-semibold text-slate-400 transition hover:text-[#FF4DA0]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 19l-7-7 7-7M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Kembali ke Portal Karyawan
          </a>
        </div>
      </div>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  if (form && submitBtn) {
    form.addEventListener('submit', () => {
      const btnText = document.getElementById('btn-text');
      const btnLoading = document.getElementById('btn-loading');
      if (btnText) btnText.classList.add('hidden');
      if (btnLoading) btnLoading.classList.remove('hidden');
      submitBtn.disabled = true;
    });
  }
</script>
