---
export const prerender = false;

import PortalAdminLayout from '../../../../layouts/PortalAdminLayout.astro';
import {
  loadSkorTierOverview,
  uniqueOutletsFromRows,
} from '../../../../lib/portal/skor-tier';
import {
  TIER_ORDER,
  formatScore,
  tierCappedLabel,
  tierGroup,
  tierStyle,
  type Tier,
  type TierGroup,
} from '../../../../lib/portal/tier';
import { ADMIN_PORTAL_ROLES, getUserAppRole } from '../../../../lib/portal/auth';

// Middleware has already enforced auth + admin role; just read the user.
const portalUser = (Astro.locals as Record<string, unknown>).portalUser as
  | { id: string; email?: string | null; app_metadata?: Record<string, unknown> | null }
  | null
  | undefined;

if (!portalUser) {
  return Astro.redirect('/portal/login');
}

// Defense-in-depth: middleware has already filtered admin-only routes, but
// fail closed here as well so a misconfigured middleware (e.g. missing env
// vars) can never silently grant admin privileges via a fallback default.
const role = getUserAppRole(portalUser);
if (!role || !ADMIN_PORTAL_ROLES.has(role)) {
  return Astro.redirect('/portal');
}
const userSummary = {
  id: portalUser.id,
  email: portalUser.email ?? null,
  role,
};

// Query params for filters.
const url = new URL(Astro.request.url);
const outletParam = url.searchParams.get('outlet');
const tierParam = url.searchParams.get('tier');
const searchParam = (url.searchParams.get('q') ?? '').trim().toLowerCase();

const { rows, period, error } = await loadSkorTierOverview(Astro, {
  outletId: outletParam || null,
});

const outlets = uniqueOutletsFromRows(rows);

// Apply client-side-style filters server-side so the URL is shareable.
const filteredRows = rows.filter((r) => {
  if (tierParam && r.tier !== tierParam) return false;
  if (searchParam) {
    const haystack = `${r.employee_name} ${r.position ?? ''} ${r.home_outlet_name ?? ''}`.toLowerCase();
    if (!haystack.includes(searchParam)) return false;
  }
  return true;
});

// Group by 3-bucket coarse group, preserving sub-tier order inside.
const grouped: Record<TierGroup, typeof filteredRows> = { top: [], mid: [], low: [] };
for (const r of filteredRows) {
  grouped[tierGroup(r.tier)].push(r);
}
for (const g of Object.keys(grouped) as TierGroup[]) {
  grouped[g].sort((a, b) => {
    const tierDiff = TIER_ORDER.indexOf(a.tier as Tier) - TIER_ORDER.indexOf(b.tier as Tier);
    if (tierDiff !== 0) return tierDiff;
    return (b.total_score ?? 0) - (a.total_score ?? 0);
  });
}

// Tier counts for chip row.
const tierCounts: Record<Tier, number> = {
  SSS: 0, SS: 0, S: 0, A: 0, B: 0, C: 0, D: 0, F: 0,
};
for (const r of rows) {
  if (r.tier in tierCounts) tierCounts[r.tier] += 1;
}

const COLUMN_META: Array<{ key: TierGroup; title: string; subtitle: string; accent: string; line: string }> = [
  { key: 'top', title: 'Top Tier',          subtitle: 'SSS · SS · S · A',  accent: 'text-emerald-700 bg-emerald-50 border-emerald-200', line: 'bg-emerald-500' },
  { key: 'mid', title: 'Standard',          subtitle: 'B · C',             accent: 'text-amber-700 bg-amber-50 border-amber-200', line: 'bg-amber-500' },
  { key: 'low', title: 'Needs Attention',   subtitle: 'D · F',             accent: 'text-rose-700 bg-rose-50 border-rose-200', line: 'bg-rose-500' },
];

function buildHref(params: Record<string, string | null | undefined>): string {
  const u = new URL(Astro.request.url);
  for (const [k, v] of Object.entries(params)) {
    if (v === null || v === undefined || v === '') {
      u.searchParams.delete(k);
    } else {
      u.searchParams.set(k, v);
    }
  }
  return `${u.pathname}?${u.searchParams.toString()}`;
}

function initials(name: string): string {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<PortalAdminLayout title={`Skor Tier — ${period}`} user={userSummary}>
  <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600">
          <svg class="h-3.5 w-3.5 text-[#7C8DFF]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M7 16h10M8.5 12h7M10 8h4M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Tier list
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
          Skor Tier <span class="text-slate-400">{period}</span>
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          Ranking karyawan berdasarkan kehadiran, penilaian manual, dan QC. Tampilan dibuat lebih bersih dengan tier tetap mudah terbaca.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3 sm:min-w-[24rem]">
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
          <div class="text-xs font-semibold text-slate-500">Total</div>
          <div class="mt-1 text-lg font-extrabold text-slate-950">{rows.length}</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
          <div class="text-xs font-semibold text-slate-500">Filtered</div>
          <div class="mt-1 text-lg font-extrabold text-slate-950">{filteredRows.length}</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
          <div class="text-xs font-semibold text-slate-500">Season</div>
          <div class="mt-1 text-lg font-extrabold text-slate-950">{period}</div>
        </div>
      </div>
    </div>

    {error && (
      <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">
        Gagal memuat data: {error}
      </div>
    )}

    <form method="GET" class="mt-5 grid gap-2 lg:grid-cols-[1fr_auto_auto_auto_auto]">
      <label class="relative min-w-0">
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <input
          type="text"
          name="q"
          value={searchParam}
          placeholder="Cari nama / posisi / outlet"
          class="w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-10 pr-3 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200"
        />
      </label>
      {role === 'admin' && (
        <select
          name="outlet"
          class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200"
        >
          <option value="">Semua outlet</option>
          {outlets.map((o) => (
            <option value={o.id ?? ''} selected={o.id === outletParam}>{o.name}</option>
          ))}
        </select>
      )}
      <select
        name="tier"
        class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200"
      >
        <option value="">Semua tier</option>
        {TIER_ORDER.map((t) => (
          <option value={t} selected={t === tierParam}>{t} ({tierCounts[t]})</option>
        ))}
      </select>
      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-700 transition"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Terapkan
      </button>
      {(searchParam || tierParam || outletParam) && (
        <a
          href={Astro.url.pathname}
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition"
        >
          Reset
        </a>
      )}
    </form>

    <div class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-8">
      {TIER_ORDER.map((t) => {
        const ts = tierStyle(t);
        const isActive = t === tierParam;
        return (
          <a
            href={buildHref({ tier: isActive ? null : t })}
            class:list={[
              'rounded-xl border bg-white p-2 text-center transition hover:border-slate-400',
              isActive ? 'border-slate-900 ring-2 ring-slate-900/10' : 'border-slate-200',
            ]}
            aria-pressed={isActive ? 'true' : 'false'}
          >
            <span class:list={['mx-auto mb-1 grid h-9 place-items-center rounded-lg', ts.ribbon]}>
              <span class="font-tier-rank text-xl leading-none">{t}</span>
            </span>
            <span class="text-xs font-semibold text-slate-500">{tierCounts[t]}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {COLUMN_META.map((col) => (
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <header class="border-b border-slate-200 p-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-extrabold text-slate-950">{col.title}</h2>
              <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-400">{col.subtitle}</p>
            </div>
            <span class:list={['rounded-full border px-2.5 py-1 text-sm font-bold tabular-nums', col.accent]}>{grouped[col.key].length}</span>
          </div>
          <div class:list={['mt-3 h-1 rounded-full', col.line]}></div>
        </header>
        <ul class="max-h-[78vh] space-y-3 overflow-y-auto p-3">
          {grouped[col.key].length === 0 ? (
            <li class="text-center text-xs text-slate-400 py-8">Tidak ada karyawan</li>
          ) : (
            grouped[col.key].map((r) => {
              const ts = tierStyle(r.tier);
              const cap = tierCappedLabel(r.tier_capped_reason);
              return (
                <li>
                  <a
                    href={`/portal/admin/skor-tier/${r.employee_id}`}
                    data-employee-id={r.employee_id}
                    class:list={[
                      'block rounded-2xl border border-slate-200 bg-white text-slate-900 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-slate-900',
                      ts.glow,
                    ]}
                  >
                    <div class:list={['flex items-center justify-between rounded-t-2xl px-4 py-2', ts.ribbon]}>
                      <span class="font-tier-rank text-3xl leading-none sm:text-4xl">
                        {r.tier}
                      </span>
                      <span class="text-xs font-bold uppercase tracking-wider">
                        {ts.label}
                      </span>
                    </div>

                    <div class="px-4 py-3">
                      <div class="flex items-start gap-3">
                        <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-sm font-bold text-slate-600 ring-1 ring-slate-200">
                          {r.photo_url ? (
                            <img src={r.photo_url} alt={r.employee_name} class="w-full h-full object-cover" />
                          ) : (
                            initials(r.employee_name)
                          )}
                        </div>
                        <div class="min-w-0 flex-1">
                          <div class="truncate text-sm font-bold text-slate-950">{r.employee_name}</div>
                          <div class="text-[11px] text-slate-400 truncate">
                            {r.position ?? '—'} · {r.home_outlet_name ?? '—'}
                          </div>
                        </div>
                        <div class="text-right shrink-0">
                          <div class="text-[10px] uppercase text-slate-400">Skor</div>
                          <div class="text-lg font-extrabold text-slate-950 tabular-nums">
                            {formatScore(r.total_score)}
                          </div>
                        </div>
                      </div>

                      <div class="mt-3 grid grid-cols-3 gap-1.5 text-[10px] text-slate-500">
                        <span class="rounded-lg bg-slate-50 px-2 py-1 text-center tabular-nums ring-1 ring-slate-200">ATT {formatScore(r.attendance_score)}</span>
                        <span class="rounded-lg bg-slate-50 px-2 py-1 text-center tabular-nums ring-1 ring-slate-200">MAN {formatScore(r.manual_score)}</span>
                        <span class="rounded-lg bg-slate-50 px-2 py-1 text-center tabular-nums ring-1 ring-slate-200">QC {formatScore(r.qc_score)}</span>
                      </div>

                      {r.icons.length > 0 && (
                        <div class="mt-2 flex flex-wrap gap-1">
                          {r.icons.slice(0, 4).map((i) => (
                            <span
                              class:list={[
                                'inline-flex items-center gap-1 rounded-full px-2 py-1 text-[10px] font-medium',
                                i.kind === 'achievement'
                                  ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200'
                                  : 'bg-rose-50 text-rose-700 ring-1 ring-rose-200',
                              ]}
                              title={i.label}
                            >
                              <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                                {i.kind === 'achievement' ? (
                                  <path d="M12 4l2.2 4.46 4.92.72-3.56 3.47.84 4.9L12 15.23l-4.4 2.32.84-4.9-3.56-3.47 4.92-.72L12 4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                                ) : (
                                  <path d="M12 8v5M12 17h.01M10.3 4.3 2.9 18a1.5 1.5 0 0 0 1.32 2.2h15.56A1.5 1.5 0 0 0 21.1 18L13.7 4.3a1.95 1.95 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                )}
                              </svg>
                              <span>{i.label}</span>
                            </span>
                          ))}
                          {r.icons.length > 4 && (
                            <span class="text-[10px] text-slate-400">+{r.icons.length - 4}</span>
                          )}
                        </div>
                      )}

                      <div class="mt-2 flex items-center justify-between gap-2 text-[10px] text-slate-400">
                        <div class="flex items-center gap-1.5">
                          {r.is_new && (
                            <span class="rounded bg-blue-50 px-1.5 py-0.5 font-medium text-blue-700 ring-1 ring-blue-200">BARU</span>
                          )}
                          {r.employment_contract === 'PARTTIME' && (
                            <span class="rounded bg-purple-50 px-1.5 py-0.5 font-medium text-purple-700 ring-1 ring-purple-200">PT</span>
                          )}
                        </div>
                        {r.rank_outlet && (
                          <span class="tabular-nums">#{r.rank_outlet} di outlet</span>
                        )}
                      </div>

                      {cap && (
                        <div class="mt-1.5 text-[10px] italic text-amber-700">{cap}</div>
                      )}
                    </div>
                  </a>
                </li>
              );
            })
          )}
        </ul>
      </div>
    ))}
  </section>

  <!--
    Realtime: subscribe to employee_score_summary changes and softly
    refresh when one is updated. Best-effort; a missing PUBLIC_*
    env at build time silently disables it.
  -->
  <script
    is:inline
    define:vars={{
      supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? '',
      supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
    }}
  >
    (function () {
      if (!supabaseUrl || !supabaseAnonKey) return;
      // Lazy-load the Supabase client from a CDN so the page payload
      // stays small and the realtime stack is fully optional. Modern
      // browsers only; older browsers gracefully skip realtime.
      import('https://esm.sh/@supabase/supabase-js@2.45.4?bundle')
        .then(function (mod) {
          var sb = mod.createClient(supabaseUrl, supabaseAnonKey, {
            auth: { persistSession: false, autoRefreshToken: false },
          });
          var pending = null;
          var refreshSoon = function () {
            if (pending) return;
            pending = window.setTimeout(function () {
              pending = null;
              window.location.replace(window.location.href);
            }, 800);
          };
          sb.channel('skor-tier-overview')
            .on(
              'postgres_changes',
              { event: '*', schema: 'public', table: 'employee_score_summary' },
              refreshSoon,
            )
            .subscribe();
        })
        .catch(function (err) {
          console.warn('[skor-tier] realtime disabled:', err);
        });
    })();
  </script>
</PortalAdminLayout>
