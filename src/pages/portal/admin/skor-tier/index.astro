---
export const prerender = false;

import PortalAdminLayout from '../../../../layouts/PortalAdminLayout.astro';
import {
  loadSkorTierOverview,
  uniqueOutletsFromRows,
} from '../../../../lib/portal/skor-tier';
import {
  TIER_ORDER,
  formatScore,
  tierCappedLabel,
  tierGroup,
  tierStyle,
  type Tier,
  type TierGroup,
} from '../../../../lib/portal/tier';
import { ADMIN_PORTAL_ROLES, getUserAppRole } from '../../../../lib/portal/auth';

// Middleware has already enforced auth + admin role; just read the user.
const portalUser = (Astro.locals as Record<string, unknown>).portalUser as
  | { id: string; email?: string | null; app_metadata?: Record<string, unknown> | null }
  | null
  | undefined;

if (!portalUser) {
  return Astro.redirect('/portal/login');
}

// Defense-in-depth: middleware has already filtered admin-only routes, but
// fail closed here as well so a misconfigured middleware (e.g. missing env
// vars) can never silently grant admin privileges via a fallback default.
const role = getUserAppRole(portalUser);
if (!role || !ADMIN_PORTAL_ROLES.has(role)) {
  return Astro.redirect('/portal');
}
const userSummary = {
  id: portalUser.id,
  email: portalUser.email ?? null,
  role,
};

// Query params for filters.
const url = new URL(Astro.request.url);
const outletParam = url.searchParams.get('outlet');
const tierParam = url.searchParams.get('tier');
const searchParam = (url.searchParams.get('q') ?? '').trim().toLowerCase();

const { rows, period, error } = await loadSkorTierOverview(Astro, {
  outletId: outletParam || null,
});

const outlets = uniqueOutletsFromRows(rows);

// Apply client-side-style filters server-side so the URL is shareable.
const filteredRows = rows.filter((r) => {
  if (tierParam && r.tier !== tierParam) return false;
  if (searchParam) {
    const haystack = `${r.employee_name} ${r.position ?? ''} ${r.home_outlet_name ?? ''}`.toLowerCase();
    if (!haystack.includes(searchParam)) return false;
  }
  return true;
});

// Group by 3-bucket coarse group, preserving sub-tier order inside.
const grouped: Record<TierGroup, typeof filteredRows> = { top: [], mid: [], low: [] };
for (const r of filteredRows) {
  grouped[tierGroup(r.tier)].push(r);
}
for (const g of Object.keys(grouped) as TierGroup[]) {
  grouped[g].sort((a, b) => {
    const tierDiff = TIER_ORDER.indexOf(a.tier as Tier) - TIER_ORDER.indexOf(b.tier as Tier);
    if (tierDiff !== 0) return tierDiff;
    return (b.total_score ?? 0) - (a.total_score ?? 0);
  });
}

// Tier counts for chip row.
const tierCounts: Record<Tier, number> = {
  SSS: 0, SS: 0, S: 0, A: 0, B: 0, C: 0, D: 0, F: 0,
};
for (const r of rows) {
  if (r.tier in tierCounts) tierCounts[r.tier] += 1;
}

const COLUMN_META: Array<{ key: TierGroup; title: string; subtitle: string; accent: string }> = [
  { key: 'top', title: 'Top Tier',          subtitle: 'SSS · SS · S · A',  accent: 'bg-emerald-500' },
  { key: 'mid', title: 'Standard',          subtitle: 'B · C',             accent: 'bg-amber-500' },
  { key: 'low', title: 'Needs Attention',   subtitle: 'D · F',             accent: 'bg-rose-500' },
];

function buildHref(params: Record<string, string | null | undefined>): string {
  const u = new URL(Astro.request.url);
  for (const [k, v] of Object.entries(params)) {
    if (v === null || v === undefined || v === '') {
      u.searchParams.delete(k);
    } else {
      u.searchParams.set(k, v);
    }
  }
  return `${u.pathname}?${u.searchParams.toString()}`;
}

function initials(name: string): string {
  return name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<PortalAdminLayout title={`Skor Tier — ${period}`} user={userSummary}>
  <!-- Header + filter row -->
  <section class="mb-6">
    <div class="flex items-end justify-between gap-3 mb-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Skor Tier
          <span class="text-base font-medium text-slate-500 ml-2">{period}</span>
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Hierarki real-time semua karyawan berdasarkan kehadiran, penilaian manual, dan QC.
        </p>
      </div>
      <div class="text-xs text-slate-500 hidden sm:block">
        {rows.length} karyawan total · {filteredRows.length} sesuai filter
      </div>
    </div>

    {error && (
      <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700">
        Gagal memuat data: {error}
      </div>
    )}

    <!-- Filter row -->
    <form method="GET" class="flex flex-wrap items-center gap-2">
      <input
        type="text"
        name="q"
        value={searchParam}
        placeholder="Cari nama / posisi / outlet"
        class="min-w-[200px] flex-1 sm:flex-none sm:w-64 rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
      />
      {role === 'admin' && (
        <select
          name="outlet"
          class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        >
          <option value="">Semua outlet</option>
          {outlets.map((o) => (
            <option value={o.id ?? ''} selected={o.id === outletParam}>{o.name}</option>
          ))}
        </select>
      )}
      <select
        name="tier"
        class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
      >
        <option value="">Semua tier</option>
        {TIER_ORDER.map((t) => (
          <option value={t} selected={t === tierParam}>{t} ({tierCounts[t]})</option>
        ))}
      </select>
      <button
        type="submit"
        class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 transition"
      >
        Terapkan
      </button>
      {(searchParam || tierParam || outletParam) && (
        <a
          href={Astro.url.pathname}
          class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition"
        >
          Reset
        </a>
      )}
    </form>

    <!-- Tier chip strip -->
    <div class="mt-3 flex flex-wrap gap-1.5 text-xs">
      {TIER_ORDER.map((t) => {
        const ts = tierStyle(t);
        const isActive = t === tierParam;
        return (
          <a
            href={buildHref({ tier: isActive ? null : t })}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-bold transition',
              ts.ribbon,
              isActive ? 'ring-2 ring-offset-1 ring-slate-900' : 'opacity-90 hover:opacity-100',
            ]}
            aria-pressed={isActive ? 'true' : 'false'}
          >
            <span class="font-tier-rank">{t}</span>
            <span class="font-medium opacity-80">{tierCounts[t]}</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 3-column game-style grid -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
    {COLUMN_META.map((col) => (
      <div class="rounded-xl bg-white border border-slate-200 overflow-hidden">
        <header class:list={['px-4 py-2.5 text-white text-sm font-bold flex items-center justify-between', col.accent]}>
          <span>{col.title}</span>
          <span class="text-xs font-medium opacity-90">{grouped[col.key].length}</span>
        </header>
        <div class="text-[10px] uppercase tracking-wider text-slate-400 px-4 pt-2">{col.subtitle}</div>
        <ul class="p-2 sm:p-3 space-y-2 sm:space-y-3 max-h-[78vh] overflow-y-auto">
          {grouped[col.key].length === 0 ? (
            <li class="text-center text-xs text-slate-400 py-8">Tidak ada karyawan</li>
          ) : (
            grouped[col.key].map((r) => {
              const ts = tierStyle(r.tier);
              const cap = tierCappedLabel(r.tier_capped_reason);
              return (
                <li>
                  <a
                    href={`/portal/admin/skor-tier/${r.employee_id}`}
                    data-employee-id={r.employee_id}
                    class:list={[
                      'block group relative rounded-lg border bg-slate-900 text-white transition hover:scale-[1.01] focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-amber-400',
                      'border-slate-700',
                      ts.glow,
                    ]}
                  >
                    <!-- Tier ribbon -->
                    <div class:list={['flex items-center justify-between rounded-t-lg px-3 py-1.5', ts.ribbon]}>
                      <span class="font-tier-rank text-lg sm:text-xl leading-none">
                        {r.tier}
                      </span>
                      <span class="text-[10px] font-bold uppercase tracking-widest">
                        {ts.label}
                      </span>
                    </div>

                    <div class="px-3 py-2.5">
                      <!-- Identity row -->
                      <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center text-sm font-semibold shrink-0 overflow-hidden">
                          {r.photo_url ? (
                            <img src={r.photo_url} alt={r.employee_name} class="w-full h-full object-cover" />
                          ) : (
                            initials(r.employee_name)
                          )}
                        </div>
                        <div class="min-w-0 flex-1">
                          <div class="text-sm font-bold text-white truncate">{r.employee_name}</div>
                          <div class="text-[11px] text-slate-400 truncate">
                            {r.position ?? '—'} · {r.home_outlet_name ?? '—'}
                          </div>
                        </div>
                        <div class="text-right shrink-0">
                          <div class="text-[10px] uppercase text-slate-400">Skor</div>
                          <div class="text-base font-bold text-white tabular-nums">
                            {formatScore(r.total_score)}
                          </div>
                        </div>
                      </div>

                      <!-- Score breakdown row -->
                      <div class="mt-2 flex items-center justify-between gap-2 text-[10px] text-slate-300">
                        <span class="bg-slate-800 px-1.5 py-0.5 rounded tabular-nums">A: {formatScore(r.attendance_score)}</span>
                        <span class="bg-slate-800 px-1.5 py-0.5 rounded tabular-nums">M: {formatScore(r.manual_score)}</span>
                        <span class="bg-slate-800 px-1.5 py-0.5 rounded tabular-nums">QC: {formatScore(r.qc_score)}</span>
                      </div>

                      <!-- Icons row -->
                      {r.icons.length > 0 && (
                        <div class="mt-2 flex flex-wrap gap-1">
                          {r.icons.slice(0, 4).map((i) => (
                            <span
                              class:list={[
                                'inline-flex items-center gap-0.5 rounded px-1.5 py-0.5 text-[10px] font-medium',
                                i.kind === 'achievement'
                                  ? 'bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-500/30'
                                  : 'bg-rose-500/15 text-rose-300 ring-1 ring-rose-500/30',
                              ]}
                              title={i.label}
                            >
                              {i.label}
                            </span>
                          ))}
                          {r.icons.length > 4 && (
                            <span class="text-[10px] text-slate-400">+{r.icons.length - 4}</span>
                          )}
                        </div>
                      )}

                      <!-- Capped + new + parttime indicators -->
                      <div class="mt-2 flex items-center justify-between gap-2 text-[10px] text-slate-400">
                        <div class="flex items-center gap-1.5">
                          {r.is_new && (
                            <span class="bg-blue-500/20 text-blue-300 ring-1 ring-blue-500/40 rounded px-1.5 py-0.5 font-medium">BARU</span>
                          )}
                          {r.employment_contract === 'PARTTIME' && (
                            <span class="bg-purple-500/20 text-purple-300 ring-1 ring-purple-500/40 rounded px-1.5 py-0.5 font-medium">PT</span>
                          )}
                        </div>
                        {r.rank_outlet && (
                          <span class="tabular-nums">#{r.rank_outlet} di outlet</span>
                        )}
                      </div>

                      {cap && (
                        <div class="mt-1.5 text-[10px] text-amber-400/90 italic">{cap}</div>
                      )}
                    </div>
                  </a>
                </li>
              );
            })
          )}
        </ul>
      </div>
    ))}
  </section>

  <!--
    Realtime: subscribe to employee_score_summary changes and softly
    refresh when one is updated. Best-effort; a missing PUBLIC_*
    env at build time silently disables it.
  -->
  <script
    is:inline
    define:vars={{
      supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL ?? '',
      supabaseAnonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
    }}
  >
    (function () {
      if (!supabaseUrl || !supabaseAnonKey) return;
      // Lazy-load the Supabase client from a CDN so the page payload
      // stays small and the realtime stack is fully optional. Modern
      // browsers only; older browsers gracefully skip realtime.
      import('https://esm.sh/@supabase/supabase-js@2.45.4?bundle')
        .then(function (mod) {
          var sb = mod.createClient(supabaseUrl, supabaseAnonKey, {
            auth: { persistSession: false, autoRefreshToken: false },
          });
          var pending = null;
          var refreshSoon = function () {
            if (pending) return;
            pending = window.setTimeout(function () {
              pending = null;
              window.location.replace(window.location.href);
            }, 800);
          };
          sb.channel('skor-tier-overview')
            .on(
              'postgres_changes',
              { event: '*', schema: 'public', table: 'employee_score_summary' },
              refreshSoon,
            )
            .subscribe();
        })
        .catch(function (err) {
          console.warn('[skor-tier] realtime disabled:', err);
        });
    })();
  </script>
</PortalAdminLayout>
