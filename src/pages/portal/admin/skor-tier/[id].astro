---
export const prerender = false;

import PortalAdminLayout from '../../../../layouts/PortalAdminLayout.astro';
import {
  loadEmployeeScoreCard,
  type ScoreCardNote,
} from '../../../../lib/portal/skor-tier';
import {
  formatScore,
  tierCappedLabel,
  tierStyle,
} from '../../../../lib/portal/tier';
import { ADMIN_PORTAL_ROLES, getUserAppRole } from '../../../../lib/portal/auth';
import { createSupabaseServerClient } from '../../../../lib/supabase/server';

const portalUser = (Astro.locals as Record<string, unknown>).portalUser as
  | { id: string; email?: string | null; app_metadata?: Record<string, unknown> | null }
  | null
  | undefined;

if (!portalUser) {
  return Astro.redirect('/portal/login');
}

// Defense-in-depth: middleware has already filtered admin-only routes, but
// fail closed here as well so a misconfigured middleware (e.g. missing env
// vars) can never silently grant admin privileges via a fallback default.
const role = getUserAppRole(portalUser);
if (!role || !ADMIN_PORTAL_ROLES.has(role)) {
  return Astro.redirect('/portal');
}
const userSummary = {
  id: portalUser.id,
  email: portalUser.email ?? null,
  role,
};

const employeeId = Astro.params.id;
if (!employeeId || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(employeeId)) {
  return Astro.redirect('/portal/admin/skor-tier');
}

const { card, error } = await loadEmployeeScoreCard(Astro, employeeId);

const url = new URL(Astro.request.url);
const notice = url.searchParams.get('notice');

if (!card) {
  return new Response(null, { status: 302, headers: { Location: '/portal/admin/skor-tier?error=not-found' } });
}

const ts = tierStyle(card.summary?.tier ?? null);
const cap = tierCappedLabel(card.summary?.tier_capped_reason ?? null);

// Load active rating aspects for the rating form (admin + kepala_gerai only).
const canRate = role === 'admin' || role === 'kepala_gerai';
let aspects: Array<{ id: string; code: string; display_name: string; category: string; max_score: number }> = [];
if (canRate) {
  const supabase = createSupabaseServerClient(Astro.request.headers.get('cookie') ?? '');
  const { data: aspectRows } = await supabase
    .from('rating_aspects')
    .select('id, code, display_name, category, max_score')
    .eq('is_active', true)
    .order('category', { ascending: true })
    .order('display_name', { ascending: true });
  aspects = (aspectRows ?? []) as typeof aspects;
}

// Build a tree from flat notes using parent_id.
type NoteNode = ScoreCardNote & { children: NoteNode[] };
function buildNoteTree(notes: ScoreCardNote[]): NoteNode[] {
  const map = new Map<string, NoteNode>();
  notes.forEach((n) => map.set(n.id, { ...n, children: [] }));
  const roots: NoteNode[] = [];
  for (const n of map.values()) {
    if (n.parent_id && map.has(n.parent_id)) {
      map.get(n.parent_id)!.children.push(n);
    } else {
      roots.push(n);
    }
  }
  // Newest top-level first; replies oldest-first (chronological reading).
  roots.sort((a, b) => b.created_at.localeCompare(a.created_at));
  for (const n of map.values()) {
    n.children.sort((a, b) => a.created_at.localeCompare(b.created_at));
  }
  return roots;
}

const tree = buildNoteTree(card.notes);

function formatRelative(iso: string): string {
  const d = new Date(iso);
  const formatter = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Makassar',
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
  return formatter.format(d);
}

const ROLE_PILL: Record<string, { label: string; cls: string }> = {
  admin:           { label: 'Admin',     cls: 'bg-rose-500/20 text-rose-200 ring-rose-500/40' },
  kepala_gerai:    { label: 'Kepala',    cls: 'bg-amber-500/20 text-amber-200 ring-amber-500/40' },
  area_supervisor: { label: 'Supervisor',cls: 'bg-sky-500/20 text-sky-200 ring-sky-500/40' },
};
---

<PortalAdminLayout title={`${card.employee.name} — Skor Tier`} user={userSummary}>
  <div class="mb-4">
    <a
      href="/portal/admin/skor-tier"
      class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.06] px-3 py-2 text-sm font-semibold text-slate-300 transition hover:bg-white/[0.1] hover:text-white"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <path d="M12 19l-7-7 7-7M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Kembali ke Skor Tier
    </a>
  </div>

  {error && (
    <div class="mb-4 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-100">
      Gagal memuat: {error}
    </div>
  )}
  {notice === 'note-created' && (
    <div class="mb-4 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
      Komentar berhasil ditambahkan.
    </div>
  )}
  {notice === 'note-deleted' && (
    <div class="mb-4 rounded-2xl border border-white/10 bg-white/[0.06] px-4 py-3 text-sm text-slate-200">
      Komentar dihapus.
    </div>
  )}
  {notice === 'rating-saved' && (
    <div class="mb-4 rounded-2xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100">
      Penilaian disimpan. Skor sedang di-recompute.
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Left: Score Card -->
    <section class="lg:col-span-1">
      <article class:list={[
        'overflow-hidden rounded-[2rem] border bg-slate-950/78 text-white shadow-[0_28px_90px_rgba(0,0,0,0.42)] backdrop-blur-xl',
        'border-white/10',
        ts.glow,
      ]}>
        <div class:list={['relative flex items-center justify-between gap-4 overflow-hidden px-5 py-5', ts.ribbon]}>
          <div>
            <span class="rank-display block text-6xl leading-none sm:text-7xl">{card.summary?.tier ?? '—'}</span>
            <span class="mt-1 block text-xs font-black uppercase tracking-[0.28em] opacity-80">{ts.label}</span>
          </div>
          <svg class="h-12 w-12 opacity-60" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M12 3l2.35 5.05 5.52.7-4.08 3.72 1.08 5.46L12 15.16 7.13 17.93l1.08-5.46-4.08-3.72 5.52-.7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="p-5">
          <h1 class="text-2xl font-black tracking-tight">{card.employee.name}</h1>
          <p class="mt-1 text-xs text-slate-400">
            {card.employee.position ?? '—'} · Periode {card.period}
          </p>

          <div class="mt-5 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-3">
              <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Total</div>
              <div class="mt-1 text-xl font-black tabular-nums">{formatScore(card.summary?.total_score ?? null)}</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-3">
              <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Outlet</div>
              <div class="mt-1 text-xl font-black tabular-nums">
                {card.summary?.rank_outlet ? `#${card.summary.rank_outlet}` : '—'}
              </div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-3">
              <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Global</div>
              <div class="mt-1 text-xl font-black tabular-nums">
                {card.summary?.rank_global ? `#${card.summary.rank_global}` : '—'}
              </div>
            </div>
          </div>

          <div class="mt-5 space-y-2 text-sm">
            <div class="flex justify-between rounded-2xl border border-white/10 bg-white/[0.05] px-3 py-2">
              <span class="text-slate-400">Kehadiran</span>
              <span class="font-black tabular-nums">{formatScore(card.summary?.attendance_score ?? null)}</span>
            </div>
            <div class="flex justify-between rounded-2xl border border-white/10 bg-white/[0.05] px-3 py-2">
              <span class="text-slate-400">Penilaian Manual</span>
              <span class="font-black tabular-nums">{formatScore(card.summary?.manual_score ?? null)}</span>
            </div>
            <div class="flex justify-between rounded-2xl border border-white/10 bg-white/[0.05] px-3 py-2">
              <span class="text-slate-400">QC</span>
              <span class="font-black tabular-nums">{formatScore(card.summary?.qc_score ?? null)}</span>
            </div>
          </div>

          <!-- Status pills -->
          <div class="mt-4 flex flex-wrap gap-1.5 text-[10px]">
            {card.employee.is_new && (
              <span class="rounded-full bg-blue-500/20 px-2.5 py-1 font-bold text-blue-300 ring-1 ring-blue-500/40">BARU (≤7 hari)</span>
            )}
            <span class:list={[
              'rounded-full px-2.5 py-1 font-bold ring-1',
              card.employee.employment_contract === 'PARTTIME'
                ? 'bg-purple-500/20 text-purple-300 ring-purple-500/40'
                : 'bg-emerald-500/20 text-emerald-300 ring-emerald-500/40',
            ]}>
              {card.employee.employment_contract ?? '—'}
            </span>
          </div>

          {cap && (
            <div class="mt-3 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-300">
              {cap}
            </div>
          )}

          <!-- Icons -->
          {card.icons.length > 0 && (
            <div class="mt-5 border-t border-white/10 pt-4">
              <h3 class="mb-2 text-[10px] font-black uppercase tracking-[0.22em] text-slate-500">Catatan Otomatis</h3>
              <div class="flex flex-wrap gap-1.5">
                {card.icons.map((i) => (
                  <span
                    class:list={[
                      'inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-bold',
                      i.kind === 'achievement'
                        ? 'bg-emerald-500/20 text-emerald-200 ring-1 ring-emerald-500/40'
                        : 'bg-rose-500/20 text-rose-200 ring-1 ring-rose-500/40',
                    ]}
                  >
                    <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                      {i.kind === 'achievement' ? (
                        <path d="M12 4l2.2 4.46 4.92.72-3.56 3.47.84 4.9L12 15.23l-4.4 2.32.84-4.9-3.56-3.47 4.92-.72L12 4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
                      ) : (
                        <path d="M12 8v5M12 17h.01M10.3 4.3 2.9 18a1.5 1.5 0 0 0 1.32 2.2h15.56A1.5 1.5 0 0 0 21.1 18L13.7 4.3a1.95 1.95 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      )}
                    </svg>
                    {i.label}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>

      <!-- Rating form (admin/kepala only) -->
      {canRate && aspects.length > 0 && (
        <details class="mt-4 rounded-[1.5rem] border border-white/10 bg-slate-950/72 text-slate-100 shadow-2xl shadow-black/20 backdrop-blur-xl">
          <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-black text-white transition hover:bg-white/[0.04] list-none [&::-webkit-details-marker]:hidden">
            <span class="inline-flex items-center gap-2">
              <svg class="h-4 w-4 text-[#7C8DFF]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Tambah / Update Penilaian
            </span>
            <svg class="h-4 w-4 text-slate-500" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <form method="POST" action="/portal/admin/api/rating" class="space-y-3 border-t border-white/10 p-4">
            <input type="hidden" name="employee_id" value={card.employee.id} />
            <input type="hidden" name="rating_period" value={card.period} />

            <div>
              <label class="mb-1.5 block text-xs font-black uppercase tracking-[0.18em] text-slate-500">Aspek</label>
              <select
                id="rating-aspect"
                name="aspect_id"
                required
                class="w-full rounded-2xl border border-white/10 bg-slate-900 px-3 py-2 text-sm font-semibold text-white focus:border-[#7C8DFF]/60 focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/15"
              >
                {aspects.map((a) => (
                  <option value={a.id} data-max-score={a.max_score}>
                    [{a.category === 'manual' ? 'Manual' : 'QC'}] {a.display_name} (max {a.max_score})
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label class="mb-1.5 block text-xs font-black uppercase tracking-[0.18em] text-slate-500">Nilai</label>
              <input
                id="rating-score"
                type="number"
                name="score"
                step="0.1"
                min="0"
                max={aspects[0]?.max_score ?? 5}
                required
                class="w-full rounded-2xl border border-white/10 bg-white/[0.07] px-3 py-2 text-sm font-semibold text-white focus:border-[#7C8DFF]/60 focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/15"
              />
              <p class="text-[11px] text-slate-400 mt-1">Sesuaikan dengan max-score aspek (mis. 0-5 untuk Manual, 0-100 untuk QC).</p>
            </div>

            <script is:inline>
              // Keep the score input's `max` attribute in sync with the
              // selected aspect's `data-max-score`. Server-side enforcement
              // also exists in /portal/admin/api/rating so this is purely UX.
              (function () {
                const sel = document.getElementById('rating-aspect');
                const num = document.getElementById('rating-score');
                if (!sel || !num) return;
                function sync() {
                  const opt = sel.options[sel.selectedIndex];
                  const max = opt && opt.dataset.maxScore;
                  if (max) num.setAttribute('max', max);
                }
                sel.addEventListener('change', sync);
                sync();
              })();
            </script>

            <div>
              <label class="mb-1.5 block text-xs font-black uppercase tracking-[0.18em] text-slate-500">Catatan (opsional)</label>
              <textarea
                name="notes"
                rows="2"
                maxlength="500"
                class="w-full resize-none rounded-2xl border border-white/10 bg-white/[0.07] px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-[#FF4DA0]/60 focus:outline-none focus:ring-4 focus:ring-[#FF4DA0]/15"
                placeholder="Konteks penilaian…"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-2xl bg-gradient-to-r from-[#FF4DA0] to-[#7C8DFF] px-4 py-2.5 text-sm font-black uppercase tracking-[0.14em] text-white shadow-[0_14px_36px_rgba(124,141,255,0.26)] transition hover:scale-[1.01]"
            >
              Simpan Penilaian
            </button>
          </form>
        </details>
      )}
    </section>

    <!-- Right: Notes -->
    <section class="lg:col-span-2">
      <header class="mb-3 flex items-center justify-between rounded-[1.5rem] border border-white/10 bg-slate-950/60 px-4 py-3 backdrop-blur-xl">
        <h2 class="inline-flex items-center gap-2 text-lg font-black text-white">
          <svg class="h-5 w-5 text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M7 8h10M7 12h6m8 0a8 8 0 0 1-11.1 7.37L4 21l1.63-5.9A8 8 0 1 1 21 12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Catatan Tim
        </h2>
        <span class="rounded-full border border-white/10 bg-white/[0.06] px-2.5 py-1 text-xs font-bold text-slate-300">{card.notes.length} komentar</span>
      </header>

      <!-- New top-level note form -->
      <form
        method="POST"
        action="/portal/admin/api/note"
        class="mb-5 rounded-[1.5rem] border border-white/10 bg-slate-950/72 p-4 shadow-2xl shadow-black/20 backdrop-blur-xl"
      >
        <input type="hidden" name="employee_id" value={card.employee.id} />
        <textarea
          name="body"
          rows="2"
          required
          minlength="1"
          maxlength="2000"
          placeholder="Tulis catatan untuk karyawan ini…"
          class="w-full resize-none rounded-2xl border border-white/10 bg-white/[0.07] px-3 py-2 text-sm text-white placeholder-slate-500 focus:border-[#7C8DFF]/60 focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/15"
        ></textarea>
        <div class="mt-2 flex items-center justify-between">
          <span class="text-[11px] text-slate-400">Komentar terlihat oleh admin & kepala gerai outlet ini.</span>
          <button
            type="submit"
            class="rounded-2xl bg-gradient-to-r from-[#FF4DA0] to-[#7C8DFF] px-4 py-2 text-sm font-black text-white shadow-[0_10px_30px_rgba(124,141,255,0.22)] transition hover:scale-[1.01]"
          >
            Kirim
          </button>
        </div>
      </form>

      <!-- Threaded list -->
      {tree.length === 0 ? (
        <div class="rounded-[1.5rem] border border-dashed border-white/15 bg-white/[0.04] p-8 text-center text-sm font-semibold text-slate-400">
          Belum ada komentar. Jadilah yang pertama memberi catatan.
        </div>
      ) : (
        <ol class="space-y-3">
          {tree.map((n) => {
            const pill = ROLE_PILL[n.author_role] ?? { label: n.author_role, cls: 'bg-slate-200 text-slate-700 ring-slate-300' };
            return (
              <li class="overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-950/70 text-slate-100 backdrop-blur-xl">
                <article class="p-3">
                  <header class="flex items-center justify-between gap-2 mb-1.5">
                    <div class="flex items-center gap-2 min-w-0">
                      <span class="truncate text-sm font-black text-white">{n.author_name}</span>
                      <span class:list={['rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ring-1', pill.cls]}>
                        {pill.label}
                      </span>
                    </div>
                    <time class="text-[11px] text-slate-400">{formatRelative(n.created_at)}</time>
                  </header>
                  <p class="whitespace-pre-wrap text-sm text-slate-300">{n.body}</p>

                  <!-- Reply toggle -->
                  <details class="mt-2 group">
                    <summary class="cursor-pointer select-none text-xs font-semibold text-slate-400 transition hover:text-white list-none [&::-webkit-details-marker]:hidden">
                      <span class="group-open:hidden">Balas</span>
                      <span class="hidden group-open:inline">Tutup balasan</span>
                    </summary>
                    <form
                      method="POST"
                      action="/portal/admin/api/note"
                      class="mt-2 rounded-2xl border border-white/10 bg-white/[0.04] p-2"
                    >
                      <input type="hidden" name="employee_id" value={card.employee.id} />
                      <input type="hidden" name="parent_id" value={n.id} />
                      <textarea
                        name="body"
                        rows="2"
                        required
                        minlength="1"
                        maxlength="2000"
                        placeholder={`Balas ${n.author_name}…`}
                        class="w-full resize-none rounded-xl border border-white/10 bg-white/[0.07] px-2 py-1.5 text-sm text-white placeholder-slate-500 focus:border-[#7C8DFF]/60 focus:outline-none focus:ring-4 focus:ring-[#7C8DFF]/15"
                      ></textarea>
                      <div class="mt-1.5 flex items-center justify-end gap-2">
                        <button
                          type="submit"
                          class="rounded-xl bg-white/[0.1] px-3 py-1 text-xs font-bold text-white transition hover:bg-white/[0.15]"
                        >
                          Balas
                        </button>
                      </div>
                    </form>
                  </details>
                </article>

                <!-- Children -->
                {n.children.length > 0 && (
                  <ol class="border-t border-white/10 bg-white/[0.03]">
                    {n.children.map((c) => {
                      const cpill = ROLE_PILL[c.author_role] ?? { label: c.author_role, cls: 'bg-slate-200 text-slate-700 ring-slate-300' };
                      return (
                        <li class="ml-3 border-l-2 border-white/10 p-3 pl-6">
                          <header class="flex items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                              <span class="truncate text-sm font-black text-white">{c.author_name}</span>
                              <span class:list={['rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ring-1', cpill.cls]}>
                                {cpill.label}
                              </span>
                            </div>
                            <time class="text-[11px] text-slate-400">{formatRelative(c.created_at)}</time>
                          </header>
                          <p class="whitespace-pre-wrap text-sm text-slate-300">{c.body}</p>
                        </li>
                      );
                    })}
                  </ol>
                )}
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </div>
</PortalAdminLayout>
