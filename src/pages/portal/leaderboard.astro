---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import PortalStatePanel from '../../components/portal/PortalStatePanel.astro';
import PortalLeaderboardTable from '../../components/portal/PortalLeaderboardTable.astro';
import { loadPortalLeaderboard } from '../../lib/portal/leaderboard';

const result = await loadPortalLeaderboard(Astro);

// Belt-and-suspenders redirect for the unauthenticated case. Middleware
// should catch this first on `/portal/*`, but we guard here too.
if (!result.ok && result.reason === 'unauthenticated') {
  return Astro.redirect('/portal/login');
}

const emptyEmployee = {
  employee_id: '',
  employee_name: 'Karyawan',
  position: null,
  home_outlet_id: null,
  home_outlet_name: null,
  photo_url: null,
  active_badge_id: null,
};
---

{result.ok && (
  <PortalLayout title="Peringkat" employee={result.leaderboard.viewer} activeSection="leaderboard">
    <div class="mb-4">
      <p class="text-sm text-gray-500">Kompetisi sehat antar karyawan</p>
      <h1 class="text-2xl font-bold text-gray-900">Peringkat Kehadiran</h1>
    </div>

    <PortalLeaderboardTable model={result.leaderboard} />
  </PortalLayout>
)}

{!result.ok && result.reason === 'no_mapping' && (
  <PortalLayout
    title="Akun Tidak Terhubung"
    employee={emptyEmployee}
    activeSection="leaderboard"
  >
    <PortalStatePanel
      variant="not-linked"
      title="Akun tidak terhubung"
      message="Akun portal Anda belum terhubung ke data karyawan aktif. Hubungi admin untuk mengaktifkan akun Anda."
    >
      <form method="POST" action="/portal/auth/sign-out" class="w-full">
        <button
          type="submit"
          class="w-full rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 transition"
        >
          Keluar
        </button>
      </form>
    </PortalStatePanel>
  </PortalLayout>
)}

{!result.ok && result.reason === 'rpc_error' && (
  <PortalLayout
    title="Terjadi Kesalahan"
    employee={emptyEmployee}
    activeSection="leaderboard"
  >
    <PortalStatePanel
      variant="error"
      title="Tidak dapat memuat peringkat"
      message="Terjadi kesalahan saat memuat data peringkat. Muat ulang halaman atau coba beberapa saat lagi."
    >
      <a
        href="/portal/leaderboard"
        class="inline-block rounded-xl bg-[#E91E8C] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#c2187a] transition"
      >
        Muat Ulang
      </a>
    </PortalStatePanel>
  </PortalLayout>
)}
