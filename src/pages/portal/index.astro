---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import PortalScheduleSection from '../../components/portal/PortalScheduleSection.astro';
import PortalStatePanel from '../../components/portal/PortalStatePanel.astro';
import { loadPortalHome } from '../../lib/portal/home';

// Load page state once — all branching is on state.kind below.
const state = await loadPortalHome(Astro);

// Belt-and-suspenders redirect for the unauthenticated state.
// Middleware should catch this first, but we guard here too.
if (state.kind === 'unauthenticated') {
  return Astro.redirect('/portal/login');
}

// Helper: derive initials for the greeting avatar fallback.
function initials(name: string): string {
  return name
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();
}
---

{state.kind === 'ready' && (
  <PortalLayout title="Beranda" employee={state.schedule.employee}>
    <!-- Greeting -->
    <div class="mb-6">
      <p class="text-sm text-gray-500">Selamat datang,</p>
      <h1 class="text-2xl font-bold text-gray-900">{state.schedule.employee.employee_name}</h1>
    </div>

    <!-- Schedule surface — today + week rows via shared component -->
    <PortalScheduleSection schedule={state.schedule} />
  </PortalLayout>
)}

{state.kind === 'empty' && (
  <PortalLayout title="Beranda" employee={state.employee}>
    <!-- Greeting retained even with no schedule -->
    <div class="mb-6">
      <p class="text-sm text-gray-500">Selamat datang,</p>
      <h1 class="text-2xl font-bold text-gray-900">{state.employee.employee_name}</h1>
    </div>

    <PortalStatePanel variant="empty" />
  </PortalLayout>
)}

{state.kind === 'not-linked' && (
  <PortalLayout
    title="Akun Tidak Terhubung"
    employee={{ employee_id: '', employee_name: 'Karyawan', position: null, home_outlet_id: null, home_outlet_name: null, photo_url: null, active_badge_id: null }}
  >
    <PortalStatePanel
      variant="not-linked"
      title="Akun tidak terhubung"
      message="Akun portal Anda belum terhubung ke data karyawan aktif. Hubungi admin untuk mengaktifkan akun Anda."
    >
      <!-- Logout action so the employee can exit the blocked state -->
      <form method="POST" action="/portal/auth/sign-out" class="w-full">
        <button
          type="submit"
          class="w-full rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 transition"
        >
          Keluar
        </button>
      </form>
    </PortalStatePanel>
  </PortalLayout>
)}

{state.kind === 'error' && (
  <PortalLayout
    title="Terjadi Kesalahan"
    employee={{ employee_id: '', employee_name: 'Karyawan', position: null, home_outlet_id: null, home_outlet_name: null, photo_url: null, active_badge_id: null }}
  >
    <PortalStatePanel
      variant="error"
      title="Terjadi kesalahan"
      message="Tidak dapat memuat data jadwal. Muat ulang halaman atau coba beberapa saat lagi."
    >
      <!-- Reload action -->
      <a
        href="/portal"
        class="inline-block rounded-xl bg-[#E91E8C] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#c2187a] transition"
      >
        Muat Ulang
      </a>
    </PortalStatePanel>
  </PortalLayout>
)}
