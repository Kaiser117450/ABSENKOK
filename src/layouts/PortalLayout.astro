---
import '../styles/global.css';
import type { PortalEmployee } from '../lib/portal/employee';

interface Props {
  title: string;
  employee: PortalEmployee;
}

const { title, employee } = Astro.props;

function initials(name: string): string {
  return name
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Portal ABSENKOK</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">

    <!-- Top navigation bar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <!-- Brand -->
        <a href="/portal" class="inline-flex items-center gap-2 shrink-0">
          <span class="text-lg font-extrabold tracking-tight">
            <span class="text-[#E91E8C]">ABSEN</span><span class="text-[#1A237E]">KOK</span>
          </span>
          <span class="hidden sm:inline text-xs font-medium text-gray-400 border border-gray-200 rounded px-1.5 py-0.5 ml-1">
            Portal Karyawan
          </span>
        </a>

        <!-- Employee identity + logout -->
        <div class="flex items-center gap-3">
          <!-- Avatar -->
          <div class="w-8 h-8 rounded-full bg-[#E91E8C]/15 flex items-center justify-center text-[#E91E8C] font-semibold text-xs shrink-0 overflow-hidden">
            {employee.photo_url ? (
              <img
                src={employee.photo_url}
                alt={employee.employee_name}
                class="w-full h-full object-cover"
              />
            ) : (
              initials(employee.employee_name)
            )}
          </div>
          <!-- Name (hide on very small screens) -->
          <span class="hidden sm:block text-sm font-medium text-gray-700 max-w-[140px] truncate">
            {employee.employee_name}
          </span>
          <!-- Logout -->
          <form method="POST" action="/portal/auth/sign-out">
            <button
              type="submit"
              class="text-xs text-gray-500 hover:text-[#E91E8C] transition px-2 py-1 rounded hover:bg-gray-100"
              aria-label="Keluar dari portal"
            >
              Keluar
            </button>
          </form>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 py-4 text-center text-xs text-gray-400">
      ABSENKOK &copy; {new Date().getFullYear()}
    </footer>
  </body>
</html>
