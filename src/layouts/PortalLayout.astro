---
import '../styles/global.css';
import type { PortalEmployee } from '../lib/portal/employee';

type ActiveSection = 'home' | 'attendance' | 'leaderboard';

interface Props {
  title: string;
  employee: PortalEmployee;
  activeSection?: ActiveSection;
}

const { title, employee, activeSection = 'home' } = Astro.props;

function initials(name: string): string {
  return name
    .split(' ')
    .slice(0, 2)
    .map((w) => w[0] ?? '')
    .join('')
    .toUpperCase();
}

function buildSubline(position: string | null, outletName: string | null): string {
  const parts: string[] = [];
  if (position && position.trim().length > 0) parts.push(position.trim());
  if (outletName && outletName.trim().length > 0) parts.push(outletName.trim());
  return parts.join(' · ');
}

const identitySubline = buildSubline(employee.position, employee.home_outlet_name);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Portal ABSENKOK</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">

    <!-- Top navigation bar — sticky, phone-first -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-3xl mx-auto px-3 sm:px-6 h-12 sm:h-14 flex items-center justify-between gap-2">

        <!-- Brand -->
        <a href="/portal" class="inline-flex items-center gap-1.5 shrink-0 min-w-0">
          <span class="text-base sm:text-lg font-extrabold tracking-tight leading-none">
            <span class="text-[#E91E8C]">ABSEN</span><span class="text-[#1A237E]">KOK</span>
          </span>
          <span class="hidden sm:inline text-xs font-medium text-gray-400 border border-gray-200 rounded px-1.5 py-0.5 ml-1 whitespace-nowrap">
            Portal Karyawan
          </span>
        </a>

        <!-- Employee identity + logout -->
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <!-- Avatar -->
          <div
            class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#E91E8C]/15 flex items-center justify-center text-[#E91E8C] font-semibold text-xs shrink-0 overflow-hidden"
            aria-hidden="true"
          >
            {employee.photo_url ? (
              <img
                src={employee.photo_url}
                alt={employee.employee_name}
                class="w-full h-full object-cover"
              />
            ) : (
              initials(employee.employee_name)
            )}
          </div>
          <!-- Name + position/outlet subline (hidden on very small phones) -->
          <div class="hidden sm:flex flex-col leading-tight min-w-0">
            <span class="text-sm font-medium text-gray-700 max-w-[180px] truncate">
              {employee.employee_name}
            </span>
            {identitySubline && (
              <span class="text-[11px] text-gray-500 max-w-[180px] truncate" title={identitySubline}>
                {identitySubline}
              </span>
            )}
          </div>
          <!-- Logout — form submit with pending feedback, no JS required -->
          <form
            method="POST"
            action="/portal/auth/sign-out"
            id="portal-logout-form"
          >
            <button
              type="submit"
              id="portal-logout-btn"
              class="text-xs text-gray-500 hover:text-[#E91E8C] transition px-2 py-1 rounded hover:bg-gray-100 whitespace-nowrap"
              aria-label="Keluar dari portal karyawan"
            >
              Keluar
            </button>
          </form>
        </div>
      </div>

      <!-- Shell nav — Beranda, Kehadiran, Peringkat destinations -->
      <nav
        class="flex items-center gap-0 border-t border-gray-100"
        aria-label="Navigasi portal"
      >
        <a
          href="/portal"
          class={`flex-1 text-center py-2 text-xs font-semibold tracking-wide transition border-b-2 ${activeSection === 'home' ? 'border-[#E91E8C] text-[#E91E8C]' : 'border-transparent text-gray-500 hover:text-gray-800'}`}
          aria-current={activeSection === 'home' ? 'page' : undefined}
        >
          Beranda
        </a>
        <a
          href="/portal/attendance"
          class={`flex-1 text-center py-2 text-xs font-semibold tracking-wide transition border-b-2 ${activeSection === 'attendance' ? 'border-[#E91E8C] text-[#E91E8C]' : 'border-transparent text-gray-500 hover:text-gray-800'}`}
          aria-current={activeSection === 'attendance' ? 'page' : undefined}
        >
          Kehadiran
        </a>
        <a
          href="/portal/leaderboard"
          class={`flex-1 text-center py-2 text-xs font-semibold tracking-wide transition border-b-2 ${activeSection === 'leaderboard' ? 'border-[#E91E8C] text-[#E91E8C]' : 'border-transparent text-gray-500 hover:text-gray-800'}`}
          aria-current={activeSection === 'leaderboard' ? 'page' : undefined}
        >
          Peringkat
        </a>
      </nav>

      <!-- Pending / loading progress bar — shown briefly on form submit or page nav -->
      <div
        id="portal-progress"
        class="h-0.5 bg-[#E91E8C] w-0 transition-all duration-300 ease-in-out"
        role="progressbar"
        aria-hidden="true"
        aria-valuemin={0}
        aria-valuemax={100}
      ></div>
    </header>

    <!-- Page content -->
    <main
      id="portal-main"
      class="flex-1 max-w-3xl mx-auto w-full px-3 sm:px-6 py-6 sm:py-8"
      aria-busy="false"
    >
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 py-4 text-center text-xs text-gray-400">
      ABSENKOK &copy; {new Date().getFullYear()}
    </footer>

    <!-- Lightweight pending affordance — no framework, inline script -->
    <script>
      (function () {
        const form = document.getElementById('portal-logout-form') as HTMLFormElement | null;
        const btn = document.getElementById('portal-logout-btn') as HTMLButtonElement | null;
        const bar = document.getElementById('portal-progress') as HTMLDivElement | null;
        const main = document.getElementById('portal-main') as HTMLElement | null;

        /** Show the progress bar and mark main as busy. */
        function showProgress(): void {
          if (bar) {
            bar.style.width = '60%';
            bar.setAttribute('aria-hidden', 'false');
          }
          if (main) main.setAttribute('aria-busy', 'true');
        }

        // ── Logout form ──────────────────────────────────────────────────────
        if (form) {
          form.addEventListener('submit', () => {
            if (btn) {
              btn.disabled = true;
              btn.textContent = 'Keluar…';
              btn.setAttribute('aria-label', 'Sedang keluar…');
            }
            showProgress();
          });
        }

        // ── Internal portal navigation and retry links ───────────────────────
        // Trigger progress bar for same-origin portal anchor clicks that would
        // cause a full-page navigation. Excludes: modified clicks (Ctrl/Cmd/Shift),
        // middle-button clicks, links with target="_blank", and external origins.
        document.addEventListener('click', (e: MouseEvent) => {
          // Skip modified or non-primary clicks — they open new tabs or have
          // browser-default handling; we should not intercept them.
          if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;

          const target = e.target as HTMLElement | null;
          const anchor = target?.closest<HTMLAnchorElement>('a[href]');
          if (!anchor) return;

          // Skip links that open in a new tab or non-http schemes.
          if (anchor.target === '_blank' || anchor.target === '_top') return;
          const href = anchor.getAttribute('href') ?? '';
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;

          // Only handle same-origin portal paths.
          try {
            const resolved = new URL(href, window.location.href);
            if (resolved.origin !== window.location.origin) return;
            if (!resolved.pathname.startsWith('/portal')) return;
          } catch {
            return;
          }

          showProgress();
        });
      })();
    </script>
  </body>
</html>
