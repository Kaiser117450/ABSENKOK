---
import '../styles/global.css';

interface AdminUserSummary {
  id: string;
  email: string | null;
  role: string;
}

interface NavItem {
  href: string;
  label: string;
  icon: 'rank' | 'board';
  match?: (pathname: string) => boolean;
}

interface Props {
  title: string;
  user: AdminUserSummary;
  /** Page-specific nav highlight; defaults to current pathname. */
  activePath?: string;
}

const { title, user, activePath } = Astro.props;
const currentPath = activePath ?? Astro.url.pathname;

const NAV_ITEMS: NavItem[] = [
  {
    href: '/portal/admin/skor-tier',
    label: 'Skor Tier',
    icon: 'rank',
    match: (p) => p.startsWith('/portal/admin/skor-tier') || p.startsWith('/portal/admin/hierarchy'),
  },
  {
    href: '/portal/admin/leaderboard',
    label: 'Leaderboard',
    icon: 'board',
    match: (p) => p.startsWith('/portal/admin/leaderboard'),
  },
];

const ROLE_LABEL: Record<string, string> = {
  admin: 'Admin',
  kepala_gerai: 'Kepala Gerai',
  area_supervisor: 'Area Supervisor',
};
const roleLabel = ROLE_LABEL[user.role] ?? user.role;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Admin Portal ABSENKOK</title>
    <meta name="robots" content="noindex, nofollow" />
    <!-- Black Ops One: angular display face used for tier rank labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Black+Ops+One&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-arena-bg text-slate-100 font-sans antialiased min-h-screen flex flex-col">
    <div class="pointer-events-none fixed inset-0 arena-grid-bg opacity-70"></div>
    <header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/80 text-white shadow-[0_16px_50px_rgba(0,0,0,0.28)] backdrop-blur-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-3">
        <!-- Brand -->
        <a href="/portal/admin/skor-tier" class="inline-flex items-center gap-2 shrink-0 min-w-0">
          <span class="grid h-9 w-9 place-items-center rounded-xl border border-[#7C8DFF]/35 bg-[#7C8DFF]/15 shadow-[0_0_24px_rgba(124,141,255,0.24)]">
            <svg class="h-[1.125rem] w-[1.125rem] text-[#FF4DA0]" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <path d="M12 3l2.35 5.05 5.52.7-4.08 3.72 1.08 5.46L12 15.16 7.13 17.93l1.08-5.46-4.08-3.72 5.52-.7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="text-base sm:text-lg font-extrabold tracking-tight leading-none">
            <span class="text-[#FF4DA0]">ABSEN</span><span class="text-[#7C8DFF]">KOK</span>
          </span>
          <span class="hidden sm:inline text-[10px] font-semibold uppercase tracking-[0.22em] text-cyan-100/80 border border-white/10 rounded-full bg-white/[0.05] px-2 py-1 ml-1 whitespace-nowrap">
            Control
          </span>
        </a>

        <!-- Inline tabs (visible from sm) -->
        <nav class="hidden sm:flex items-center gap-1 grow ml-6" aria-label="Admin navigation">
          {NAV_ITEMS.map((item) => {
            const isActive = item.match ? item.match(currentPath) : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold rounded-xl border transition',
                  isActive
                    ? 'border-[#7C8DFF]/45 bg-[#7C8DFF]/18 text-white shadow-[0_0_24px_rgba(124,141,255,0.18)]'
                    : 'border-transparent text-slate-300 hover:text-white hover:bg-white/[0.08] hover:border-white/10',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.icon === 'rank' ? (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M7 16h10M8.5 12h7M10 8h4M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                ) : (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M8 18V9m4 9V5m4 13v-6M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- User identity + sign out -->
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
          <div class="text-right hidden sm:block">
            <div class="text-xs leading-tight text-slate-200">{user.email ?? 'Admin'}</div>
            <div class="text-[10px] uppercase tracking-[0.2em] text-slate-500">{roleLabel}</div>
          </div>
          <form method="POST" action="/portal/admin/auth/sign-out">
            <button
              type="submit"
              class="inline-flex items-center gap-1.5 rounded-xl border border-white/10 px-3 py-1.5 text-xs font-semibold text-slate-300 transition hover:bg-white/[0.1] hover:text-white whitespace-nowrap"
              aria-label="Keluar dari admin portal"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                <path d="M15 7l5 5-5 5M20 12H9M11 4H5v16h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Keluar
            </button>
          </form>
        </div>
      </div>

      <!-- Mobile tab strip -->
      <nav class="sm:hidden border-t border-white/10 bg-slate-950/80" aria-label="Admin navigation (mobile)">
        <div class="max-w-7xl mx-auto px-2 flex overflow-x-auto gap-1">
          {NAV_ITEMS.map((item) => {
            const isActive = item.match ? item.match(currentPath) : currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold whitespace-nowrap border-b-2',
                  isActive ? 'text-white border-[#FF4DA0]' : 'text-slate-400 border-transparent',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.icon === 'rank' ? (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M7 16h10M8.5 12h7M10 8h4M12 3l6 3v5c0 4.2-2.5 7.4-6 9-3.5-1.6-6-4.8-6-9V6l6-3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                ) : (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" fill="none">
                    <path d="M8 18V9m4 9V5m4 13v-6M5 21h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {item.label}
              </a>
            );
          })}
        </div>
      </nav>
    </header>

    <main class="relative z-10 flex-1 max-w-7xl mx-auto w-full px-3 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <footer class="relative z-10 border-t border-white/10 py-4 text-center text-xs text-slate-500">
      ABSENKOK Admin &copy; {new Date().getFullYear()}
    </footer>
  </body>
</html>
