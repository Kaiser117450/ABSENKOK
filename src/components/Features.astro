---
// Features.astro — Feature showcase with Lucide icons, scroll animations, and card glow effects
import { Image } from 'astro:assets';
import { Wifi, CalendarDays, ChartBar, TabletSmartphone } from '@lucide/astro';
import tanganScanImg from '../assets/images/Tangan scan.png';

const features = [
  {
    title: "Absensi NFC Otomatis",
    description: "Karyawan cukup tap kartu NFC di tablet — hadir langsung tercatat. Tanpa username, tanpa password.",
    color: "bg-brand-pink/10 text-brand-pink",
    iconBg: "bg-brand-pink/10",
    number: "01",
  },
  {
    title: "Jadwal Shift Cerdas",
    description: "Atur jadwal Pagi, Siang, Sore untuk semua karyawan dalam satu tampilan grid mingguan.",
    color: "bg-brand-teal/15 text-brand-teal-dark",
    iconBg: "bg-brand-teal/15",
    number: "02",
  },
  {
    title: "Laporan Real-Time",
    description: "Pantau siapa yang sudah masuk, sedang break, atau sudah pulang — langsung dari dashboard admin.",
    color: "bg-brand-navy/10 text-brand-navy",
    iconBg: "bg-brand-navy/10",
    number: "03",
  },
  {
    title: "Mode Kiosk 24/7",
    description: "Tablet berjalan non-stop sebagai kiosk absensi. Tidak perlu pengawasan, tidak perlu restart.",
    color: "bg-brand-mint text-brand-teal-dark",
    iconBg: "bg-brand-mint",
    number: "04",
  },
];

const iconComponents = [Wifi, CalendarDays, ChartBar, TabletSmartphone];
---

<section id="fitur" class="relative bg-brand-surface py-20 lg:py-28 overflow-hidden">
  <!-- Decorative background blobs -->
  <div class="absolute top-0 left-0 w-[400px] h-[400px] bg-brand-mint/50 rounded-full blur-[100px] -translate-y-1/2 -translate-x-1/4"></div>
  <div class="absolute bottom-0 right-0 w-[300px] h-[300px] bg-brand-teal/15 rounded-full blur-[80px] translate-y-1/3 translate-x-1/4"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll anim-fade-up">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-pink/10 px-4 py-1.5 text-sm font-medium text-brand-pink mb-4">
        <Wifi class="h-4 w-4" />
        Fitur Lengkap
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl">
        Fitur <span class="text-gradient-pink">Unggulan</span>
      </h2>
      <p class="mt-4 text-lg leading-8 text-brand-text-secondary">
        Semua yang dibutuhkan untuk mengelola kehadiran karyawan restoran.
      </p>
    </div>

    <!-- Phone mockup + Feature cards layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- Left: Phone mockup showcase -->
      <div class="lg:col-span-4 flex justify-center animate-on-scroll anim-slide-left">
        <div class="relative group">
          <!-- Glow behind phone -->
          <div class="absolute inset-0 bg-brand-pink/10 rounded-full blur-[60px] scale-75 group-hover:scale-90 transition-transform duration-500"></div>
          <Image
            src={tanganScanImg}
            alt="Tampilan pilihan jenis absensi pada aplikasi ABSENKOK"
            width={380}
            class="relative drop-shadow-2xl animate-float group-hover:scale-[1.02] transition-transform duration-500"
          />
        </div>
      </div>

      <!-- Right: 2x2 Feature cards -->
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {features.map((feature, i) => {
          const Icon = iconComponents[i];
          const delayClass = `delay-${(i + 1) * 100}`;

          return (
            <div
              class={`animate-on-scroll anim-slide-up ${delayClass}`}
            >
              <div class="group relative rounded-2xl bg-white p-7 shadow-sm ring-1 ring-brand-border hover:shadow-lg hover:-translate-y-1 transition-all duration-300 card-glow h-full overflow-hidden">
                {/* Feature number watermark */}
                <span class="absolute top-3 right-4 text-5xl font-extrabold text-brand-text-muted/[0.07] select-none pointer-events-none leading-none">
                  {feature.number}
                </span>

                {/* Icon */}
                <div class={`relative h-12 w-12 rounded-xl ${feature.color} flex items-center justify-center group-hover:scale-110 transition-transform duration-300`}>
                  <Icon class="h-6 w-6" />
                </div>

                {/* Text */}
                <h3 class="mt-5 text-lg font-semibold text-brand-navy">{feature.title}</h3>
                <p class="mt-2 text-sm leading-6 text-brand-text-secondary">{feature.description}</p>

                {/* Bottom accent line */}
                <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-brand-teal/30 to-transparent scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
