---
// Hero.astro — Enhanced hero with animated text, floating particles, stats counter
import { Image } from 'astro:assets';
import { Download, ChevronDown, Smartphone, Users, Clock } from '@lucide/astro';
import heroImage from '../assets/images/enakko-hero.png';
---

<section class="relative bg-white py-20 lg:py-32 overflow-hidden">
  <!-- Decorative background shapes -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-mint/40 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/4"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-teal/20 rounded-full blur-[80px] translate-y-1/3 -translate-x-1/4"></div>

  <!-- Floating particles -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-[15%] left-[8%] w-3 h-3 rounded-full bg-brand-pink/20" style="animation: float-diagonal 8s ease-in-out infinite;"></div>
    <div class="absolute top-[25%] right-[12%] w-2 h-2 rounded-full bg-brand-teal/30" style="animation: float-diagonal 10s ease-in-out infinite 1s;"></div>
    <div class="absolute bottom-[20%] left-[15%] w-2.5 h-2.5 rounded-full bg-brand-mint" style="animation: float-diagonal 7s ease-in-out infinite 2s;"></div>
    <div class="absolute top-[60%] right-[5%] w-1.5 h-1.5 rounded-full bg-brand-pink/25" style="animation: float 5s ease-in-out infinite 0.5s;"></div>
    <div class="absolute top-[10%] left-[40%] w-2 h-2 rounded-full bg-brand-teal/20" style="animation: float 6s ease-in-out infinite 1.5s;"></div>
    <!-- Decorative rings -->
    <div class="absolute top-[30%] right-[20%] w-20 h-20 rounded-full border border-brand-mint/30" style="animation: spin-slow 25s linear infinite;"></div>
    <div class="absolute bottom-[15%] left-[25%] w-12 h-12 rounded-full border border-brand-teal/20" style="animation: counter-spin 20s linear infinite;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 lg:items-center">

      <!-- Left Column: Text -->
      <div class="max-w-xl animate-on-scroll anim-slide-left">
        <!-- Badge with NFC ripple -->
        <div class="inline-flex items-center gap-2 rounded-full bg-brand-mint px-4 py-1.5 text-sm font-medium text-brand-navy mb-6">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-[ping-ring_1.5s_ease-out_infinite] absolute inline-flex h-full w-full rounded-full bg-brand-teal opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-teal"></span>
          </span>
          Sistem Absensi NFC #1
        </div>

        <h1 data-balanced class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-brand-navy leading-[1.1]">
          Absensi NFC untuk <span class="text-gradient-pink">Restoran Modern</span>
        </h1>

        <p class="mt-6 text-lg leading-8 text-brand-text-secondary">
          Tap kartu, hadir tercatat. ABSENKOK mengelola kehadiran karyawan dengan NFC, jadwal shift otomatis, dan laporan real-time.
        </p>

        <!-- CTA Buttons -->
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="https://github.com/Kaiser117450/ABSENKOK/releases"
            class="group relative inline-flex items-center gap-2 rounded-full bg-brand-pink text-white px-8 py-3.5 font-semibold shadow-lg shadow-brand-pink/25 hover:bg-brand-pink-dark hover:shadow-xl hover:shadow-brand-pink/30 transition-all duration-300 hover:-translate-y-0.5 glow-pink overflow-hidden"
          >
            <Download class="h-5 w-5 group-hover:translate-y-0.5 transition-transform duration-300" />
            Download APK
            <!-- Shine sweep -->
            <div class="absolute inset-0 rounded-full">
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
            </div>
          </a>
          <a href="#fitur" class="group inline-flex items-center gap-2 rounded-full border-2 border-brand-navy/20 text-brand-navy px-7 py-3 font-semibold hover:border-brand-teal hover:text-brand-teal transition-all duration-300">
            Lihat Fitur
            <ChevronDown class="h-4 w-4 group-hover:translate-y-0.5 transition-transform duration-300" />
          </a>
        </div>

        <!-- Stats Counter Row -->
        <div class="mt-12 grid grid-cols-3 gap-6 max-w-sm">
          <div class="text-center animate-on-scroll anim-fade-up delay-200">
            <div class="flex justify-center mb-2">
              <div class="h-10 w-10 rounded-xl bg-brand-teal/15 flex items-center justify-center">
                <Smartphone class="h-5 w-5 text-brand-teal-dark" />
              </div>
            </div>
            <div class="text-2xl font-extrabold text-brand-navy" data-count-to="12" data-count-suffix="+">0+</div>
            <div class="text-xs text-brand-text-muted mt-0.5">Gerai Aktif</div>
          </div>
          <div class="text-center animate-on-scroll anim-fade-up delay-300">
            <div class="flex justify-center mb-2">
              <div class="h-10 w-10 rounded-xl bg-brand-pink/10 flex items-center justify-center">
                <Users class="h-5 w-5 text-brand-pink" />
              </div>
            </div>
            <div class="text-2xl font-extrabold text-brand-navy" data-count-to="50" data-count-suffix="+">0+</div>
            <div class="text-xs text-brand-text-muted mt-0.5">Karyawan</div>
          </div>
          <div class="text-center animate-on-scroll anim-fade-up delay-400">
            <div class="flex justify-center mb-2">
              <div class="h-10 w-10 rounded-xl bg-brand-navy/10 flex items-center justify-center">
                <Clock class="h-5 w-5 text-brand-navy" />
              </div>
            </div>
            <div class="text-2xl font-extrabold text-brand-navy">24/7</div>
            <div class="text-xs text-brand-text-muted mt-0.5">Kiosk Mode</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Phone Image with glow -->
      <div class="relative flex justify-center lg:justify-end animate-on-scroll anim-slide-right delay-200">
        <!-- Glow ring behind phone -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-[320px] h-[320px] rounded-full bg-gradient-to-br from-brand-pink/10 via-brand-teal/10 to-brand-mint/20 blur-[60px]" style="animation: pulse-soft 4s ease-in-out infinite;"></div>
        </div>
        <div class="animate-float relative">
          <Image
            src={heroImage}
            alt="Tangan memegang smartphone menampilkan dashboard admin ABSENKOK"
            width={480}
            class="drop-shadow-2xl relative z-10"
          />
        </div>
      </div>

    </div>
  </div>
</section>
