---
// Download.astro — Simple download section
import { Download } from '@lucide/astro';
---

<section id="download" class="relative bg-brand-navy pt-40 lg:pt-52 pb-20 lg:pb-28 overflow-hidden">
  <!-- Subtle background -->
  <div class="absolute top-0 left-1/4 w-72 h-72 bg-brand-teal/10 rounded-full blur-[80px]"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-brand-pink/8 rounded-full blur-[60px]"></div>

  <div class="relative max-w-2xl mx-auto px-6 text-center animate-on-scroll anim-fade-up">
    <h2 data-balanced class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Download ABSENKOK
    </h2>

    <p class="mt-4 text-base leading-7 text-white/50">
      Sistem absensi NFC untuk karyawan Ayam Guling Enakko.
    </p>

    <div class="mt-8">
      <a
        href="https://github.com/Kaiser117450/ABSENKOK/releases"
        class="inline-flex items-center gap-2 bg-brand-pink text-white rounded-full px-8 py-3.5 font-semibold hover:bg-brand-pink-dark transition-colors duration-200"
      >
        <Download class="h-5 w-5" />
        Download APK
      </a>
    </div>

    <p class="mt-3 text-xs text-white/25">
      Android 7.0+ &middot; ~95 MB
    </p>
  </div>
</section>
