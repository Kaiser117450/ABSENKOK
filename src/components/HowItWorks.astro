---
// HowItWorks.astro — 3-step alternating zigzag layout with animated connectors
import { Image } from 'astro:assets';
import { Tablet, CreditCard, LayoutDashboard } from '@lucide/astro';
import tanganScansImg from '../assets/images/tangan scans.png';
import loginImg from '../assets/images/login-success.png';
import laporanImg from '../assets/images/laporan tampilan.png';

const steps = [
  {
    number: 1,
    label: "Langkah Pertama",
    title: "Pasang Tablet",
    description: "Letakkan tablet Android di area masuk restoran. Buka ABSENKOK dalam mode kiosk — layar langsung menampilkan halaman scan kartu NFC 24/7.",
    color: "bg-brand-teal",
    labelColor: "text-brand-teal",
    image: tanganScansImg,
    imageAlt: "Tangan memegang tablet menampilkan layar scan kartu NFC ABSENKOK",
    imageWidth: 480,
  },
  {
    number: 2,
    label: "Langkah Kedua",
    title: "Tap Kartu NFC",
    description: "Karyawan tap kartu NFC masing-masing ke tablet saat masuk dan pulang kerja. Konfirmasi \"Berhasil!\" muncul langsung di layar — tanpa login, tanpa ribet.",
    color: "bg-brand-pink",
    labelColor: "text-brand-pink",
    image: loginImg,
    imageAlt: "Tampilan konfirmasi berhasil setelah tap kartu NFC",
    imageWidth: 320,
  },
  {
    number: 3,
    label: "Langkah Ketiga",
    title: "Pantau & Kelola",
    description: "Admin lihat dashboard kehadiran real-time, atur jadwal shift, dan export laporan ke CSV. Semua data tersaji lengkap dalam satu tampilan.",
    color: "bg-brand-navy",
    labelColor: "text-brand-navy",
    image: laporanImg,
    imageAlt: "Dashboard laporan kehadiran karyawan dengan export CSV",
    imageWidth: 380,
  },
];

const stepIcons = [Tablet, CreditCard, LayoutDashboard];
---

<section id="cara-kerja" class="bg-white py-20 lg:py-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center max-w-2xl mx-auto mb-20 animate-on-scroll anim-fade-up">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-mint px-4 py-1.5 text-sm font-medium text-brand-navy mb-4">
        <svg class="h-4 w-4 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Mudah & Cepat
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-brand-navy sm:text-4xl">
        Cara Kerja
      </h2>
      <p class="mt-4 text-lg leading-8 text-brand-text-secondary">
        Tiga langkah sederhana untuk memulai absensi digital.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Vertical connector line (desktop only) -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-brand-teal via-brand-pink to-brand-navy opacity-20 -translate-x-1/2"></div>

      {steps.map((step, i) => {
        const Icon = stepIcons[i];
        const isReversed = i === 1;

        return (
          <div class={`grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-center ${i < steps.length - 1 ? 'mb-20 lg:mb-28' : ''}`}>
            {/* Image */}
            <div class={`flex justify-center ${isReversed ? 'order-2 md:order-2' : ''} animate-on-scroll ${isReversed ? 'anim-slide-right' : 'anim-slide-left'} delay-${(i + 1) * 100}`}>
              <div class="relative group">
                {/* Glow behind image */}
                <div class={`absolute inset-0 ${step.color}/10 rounded-3xl blur-[40px] scale-90 group-hover:scale-100 transition-transform duration-500`}></div>
                <Image
                  src={step.image}
                  alt={step.imageAlt}
                  width={step.imageWidth}
                  class="relative drop-shadow-xl max-w-full h-auto group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>
            </div>

            {/* Text */}
            <div class={`${isReversed ? 'order-1 md:order-1' : ''} animate-on-scroll anim-fade-up delay-${(i + 2) * 100}`}>
              {/* Step number + icon */}
              <div class="flex items-center gap-4 mb-5">
                <div class={`relative h-16 w-16 rounded-2xl ${step.color} text-white text-2xl font-bold shadow-lg flex items-center justify-center shrink-0 group`}>
                  <span class="relative z-10">{step.number}</span>
                  {/* Ping ring */}
                  <div class={`absolute inset-0 rounded-2xl ${step.color}/50 animate-[ping-ring_2s_ease-out_infinite]`}></div>
                </div>
                <div>
                  <span class={`text-xs font-semibold ${step.labelColor} uppercase tracking-widest`}>{step.label}</span>
                  <div class="flex items-center gap-2 mt-0.5">
                    <Icon class={`h-4 w-4 ${step.labelColor}`} />
                    <span class="text-sm text-brand-text-muted">→</span>
                  </div>
                </div>
              </div>

              <h3 class="text-2xl lg:text-3xl font-bold text-brand-navy">{step.title}</h3>
              <p class="text-base lg:text-lg leading-7 text-brand-text-secondary mt-4 max-w-md">
                {step.description}
              </p>

              {/* Mini feature tags */}
              {i === 0 && (
                <div class="flex flex-wrap gap-2 mt-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-teal/10 px-3 py-1 text-xs font-medium text-brand-teal-dark">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-teal"></span>
                    Mode Kiosk
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-teal/10 px-3 py-1 text-xs font-medium text-brand-teal-dark">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-teal"></span>
                    24/7 Aktif
                  </span>
                </div>
              )}
              {i === 1 && (
                <div class="flex flex-wrap gap-2 mt-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-pink/10 px-3 py-1 text-xs font-medium text-brand-pink">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-pink"></span>
                    e-KTP
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-pink/10 px-3 py-1 text-xs font-medium text-brand-pink">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-pink"></span>
                    e-Toll
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-pink/10 px-3 py-1 text-xs font-medium text-brand-pink">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-pink"></span>
                    Flazz
                  </span>
                </div>
              )}
              {i === 2 && (
                <div class="flex flex-wrap gap-2 mt-5">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-navy/10 px-3 py-1 text-xs font-medium text-brand-navy">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-navy"></span>
                    Dashboard
                  </span>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-navy/10 px-3 py-1 text-xs font-medium text-brand-navy">
                    <span class="h-1.5 w-1.5 rounded-full bg-brand-navy"></span>
                    Export CSV
                  </span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
