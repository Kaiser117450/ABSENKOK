---
// Footer.astro — Minimalist dark footer with links and developer credit
import { Image } from 'astro:assets';
import akmLabLogo from '../assets/images/akmlav.png';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-navy-dark py-10 border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center gap-5">
      {/* Logo */}
      <a href="/" class="text-lg font-extrabold tracking-tight">
        <span class="text-brand-pink">ABSEN</span><span class="text-white">KOK</span>
      </a>

      {/* Links */}
      <div class="flex flex-wrap justify-center gap-6">
        <a href="#fitur" class="text-sm text-white/40 hover:text-white/70 transition-colors duration-200">Fitur</a>
        <a href="#cara-kerja" class="text-sm text-white/40 hover:text-white/70 transition-colors duration-200">Cara Kerja</a>
        <a href="#arsitektur" class="text-sm text-white/40 hover:text-white/70 transition-colors duration-200">Arsitektur</a>
        <a href="https://github.com/Kaiser117450/ABSENKOK" target="_blank" rel="noopener noreferrer" class="text-sm text-white/40 hover:text-white/70 transition-colors duration-200">GitHub</a>
      </div>

      {/* Copyright + credit */}
      <div class="text-center">
        <p class="text-xs text-white/25">
          &copy; {currentYear} ABSENKOK &middot; Dibuat oleh <span class="text-white/40">Akmal</span>
        </p>
      </div>
    </div>
  </div>
</footer>
