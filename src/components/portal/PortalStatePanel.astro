---
/**
 * PortalStatePanel — shared card surface for all non-ready portal states.
 *
 * Supports: loading | empty | not-linked | error
 *
 * Props:
 *   variant  — which state to render
 *   title    — card heading (optional; a sensible default is supplied per variant)
 *   message  — supporting copy shown beneath the title
 */

interface Props {
  variant: 'loading' | 'empty' | 'not-linked' | 'error';
  title?: string;
  message?: string;
}

const DEFAULTS: Record<Props['variant'], { title: string; message: string }> = {
  loading: {
    title: 'Memuat data…',
    message: 'Harap tunggu sebentar.',
  },
  empty: {
    title: 'Belum ada jadwal',
    message: 'Jadwal minggu ini belum diterbitkan oleh admin.',
  },
  'not-linked': {
    title: 'Akun tidak terhubung',
    message: 'Akun portal Anda belum terhubung ke data karyawan aktif. Hubungi admin untuk mengaktifkan akun Anda.',
  },
  error: {
    title: 'Terjadi kesalahan',
    message: 'Tidak dapat memuat data. Coba muat ulang halaman.',
  },
};

const { variant, title, message } = Astro.props;

const defaults = DEFAULTS[variant];
const resolvedTitle = title ?? defaults.title;
const resolvedMessage = message ?? defaults.message;

// Icon and colour tokens per variant
const isLoading = variant === 'loading';
const isEmpty = variant === 'empty';
const isNotLinked = variant === 'not-linked';
const isError = variant === 'error';

// Border and icon colour classes
const borderClass = isError || isNotLinked
  ? 'border-red-200'
  : isEmpty
  ? 'border-dashed border-gray-300'
  : 'border-gray-200';

const iconBgClass = isError || isNotLinked
  ? 'bg-red-100'
  : isEmpty
  ? 'bg-gray-100'
  : 'bg-gray-50';

const iconColorClass = isError || isNotLinked
  ? 'text-red-500'
  : 'text-gray-400';
---

<div
  class={`bg-white rounded-2xl border shadow-sm p-6 flex flex-col items-center text-center gap-4 ${borderClass}`}
  role="status"
  aria-live="polite"
  aria-label={resolvedTitle}
>
  <!-- Icon area -->
  <div class={`w-12 h-12 rounded-full flex items-center justify-center shrink-0 ${iconBgClass}`}>
    {isLoading && (
      <!-- Spinner -->
      <svg
        class={`w-6 h-6 animate-spin ${iconColorClass}`}
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    )}
    {isEmpty && (
      <!-- Calendar icon -->
      <svg
        class={`w-6 h-6 ${iconColorClass}`}
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
    )}
    {(isNotLinked || isError) && (
      <!-- Warning / alert triangle -->
      <svg
        class={`w-6 h-6 ${iconColorClass}`}
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      </svg>
    )}
  </div>

  <!-- Text -->
  <div class="min-w-0 w-full">
    <p class="font-semibold text-gray-900 text-base mb-1">{resolvedTitle}</p>
    <p class="text-sm text-gray-500">{resolvedMessage}</p>
  </div>

  <!-- Optional action area slot -->
  <slot />
</div>
