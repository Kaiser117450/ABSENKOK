---
/**
 * PortalAttendanceSummary — month-to-date attendance summary card surface.
 *
 * Renders the month-to-date recap summary counts from the Phase 42 typed
 * recap model. Phone-first stacked layout — no table/grid.
 *
 * Props:
 *   summaryCounts — the `AttendanceSummaryCounts` from the recap model.
 *   monthStart    — ISO date "YYYY-MM-DD" for the first day of the current month.
 *   currentStreak — consecutive days present (from employee_streaks table).
 *
 * Scope guard:
 *   - does not fetch data or derive counts
 *   - does not include exception/warning copy reserved for Phase 44
 *   - no client framework or new dependencies
 */

import type { AttendanceSummaryCounts } from '../../lib/portal/attendance-recap';

interface Props {
  summaryCounts: AttendanceSummaryCounts;
  monthStart: string;
  /** Number of prior-day follow-up gaps (belum_pulang + tidak_hadir) from the recap dataset. */
  followUpCount?: number;
  /** Current consecutive attendance streak (days). */
  currentStreak?: number;
}

const { summaryCounts, monthStart, followUpCount = 0, currentStreak = 0 } = Astro.props;

/** Format "YYYY-MM-DD" into a localized month name, e.g. "Maret 2026". */
function formatMonthLabel(isoDate: string): string {
  const d = new Date(isoDate + 'T00:00:00');
  return d.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
}

interface SummaryChip {
  label: string;
  count: number;
  chipBg: string;
  countColor: string;
  labelColor: string;
}

const chips: SummaryChip[] = [
  {
    label: 'Hadir',
    count: summaryCounts.hadir,
    chipBg: 'bg-emerald-50 border border-emerald-200',
    countColor: 'text-emerald-700',
    labelColor: 'text-emerald-600',
  },
  {
    label: 'Tidak Hadir',
    count: summaryCounts.tidakHadir,
    chipBg: 'bg-red-50 border border-red-200',
    countColor: 'text-red-700',
    labelColor: 'text-red-600',
  },
  {
    label: 'Sakit',
    count: summaryCounts.sakit,
    chipBg: 'bg-orange-50 border border-orange-200',
    countColor: 'text-orange-700',
    labelColor: 'text-orange-600',
  },
  {
    label: 'Izin',
    count: summaryCounts.izin,
    chipBg: 'bg-sky-50 border border-sky-200',
    countColor: 'text-sky-700',
    labelColor: 'text-sky-600',
  },
  {
    label: 'Belum Pulang',
    count: summaryCounts.belumPulang,
    chipBg: 'bg-amber-50 border border-amber-200',
    countColor: 'text-amber-700',
    labelColor: 'text-amber-600',
  },
  {
    label: 'Libur',
    count: summaryCounts.libur,
    chipBg: 'bg-gray-50 border border-gray-200',
    countColor: 'text-gray-600',
    labelColor: 'text-gray-500',
  },
];
---

<section aria-label="Ringkasan kehadiran bulan ini">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
    Ringkasan {formatMonthLabel(monthStart)}
  </h2>

  <div class="grid grid-cols-3 gap-2" role="list">
    {chips.map((chip) => (
      <div
        class={`${chip.chipBg} rounded-2xl p-3 flex flex-col items-center text-center`}
        role="listitem"
      >
        <span class={`text-2xl font-bold leading-none ${chip.countColor}`}>
          {chip.count}
        </span>
        <span class={`text-xs mt-1 font-medium leading-tight ${chip.labelColor}`}>
          {chip.label}
        </span>
      </div>
    ))}
  </div>

  {currentStreak > 0 && (
    <div
      class="mt-3 flex items-center gap-2 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5"
      role="note"
      aria-label={`${currentStreak} hari berturut-turut hadir`}
    >
      <svg
        class="w-5 h-5 shrink-0 streak-fire"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M12 23C16.5 23 20 19.5 20 15.5C20 11.5 17 8 15 6C14.5 8 13 9.5 12 10C11.5 7.5 10 4 7 2C7 4.5 5 8 4 11C3.5 12.5 4 15 4 15.5C4 19.5 7.5 23 12 23Z"
          fill="url(#fire-gradient)"
          stroke="#D97706"
          stroke-width="0.5"
        >
          <animate attributeName="d" dur="1.5s" repeatCount="indefinite" values="
            M12 23C16.5 23 20 19.5 20 15.5C20 11.5 17 8 15 6C14.5 8 13 9.5 12 10C11.5 7.5 10 4 7 2C7 4.5 5 8 4 11C3.5 12.5 4 15 4 15.5C4 19.5 7.5 23 12 23Z;
            M12 23C16.5 23 20 19.5 20 15.5C20 11.5 17 7.5 15 5.5C14.5 7.5 13 9 12 9.5C11.5 7 10 3.5 7 1.5C7 4 5 7.5 4 10.5C3.5 12 4 14.5 4 15.5C4 19.5 7.5 23 12 23Z;
            M12 23C16.5 23 20 19.5 20 15.5C20 11.5 17 8 15 6C14.5 8 13 9.5 12 10C11.5 7.5 10 4 7 2C7 4.5 5 8 4 11C3.5 12.5 4 15 4 15.5C4 19.5 7.5 23 12 23Z
          "/>
        </path>
        <path
          d="M12 23C14.5 23 16.5 21 16.5 18.5C16.5 16 15 14.5 14 13.5C13.5 14.5 13 15.5 12 16C11.5 14.5 11 13 10 12C9.5 13 9 14.5 8.5 16C8 17.5 7.5 18.5 7.5 18.5C7.5 21 9.5 23 12 23Z"
          fill="url(#fire-inner-gradient)"
        >
          <animate attributeName="d" dur="1.2s" repeatCount="indefinite" values="
            M12 23C14.5 23 16.5 21 16.5 18.5C16.5 16 15 14.5 14 13.5C13.5 14.5 13 15.5 12 16C11.5 14.5 11 13 10 12C9.5 13 9 14.5 8.5 16C8 17.5 7.5 18.5 7.5 18.5C7.5 21 9.5 23 12 23Z;
            M12 23C14.5 23 16.5 21 16.5 18.5C16.5 16 15 14 14 13C13.5 14 13 15 12 15.5C11.5 14 11 12.5 10 11.5C9.5 12.5 9 14 8.5 15.5C8 17 7.5 18.5 7.5 18.5C7.5 21 9.5 23 12 23Z;
            M12 23C14.5 23 16.5 21 16.5 18.5C16.5 16 15 14.5 14 13.5C13.5 14.5 13 15.5 12 16C11.5 14.5 11 13 10 12C9.5 13 9 14.5 8.5 16C8 17.5 7.5 18.5 7.5 18.5C7.5 21 9.5 23 12 23Z
          "/>
        </path>
        <defs>
          <linearGradient id="fire-gradient" x1="12" y1="2" x2="12" y2="23" gradientUnits="userSpaceOnUse">
            <stop stop-color="#F59E0B"/>
            <stop offset="0.5" stop-color="#F97316"/>
            <stop offset="1" stop-color="#DC2626"/>
          </linearGradient>
          <linearGradient id="fire-inner-gradient" x1="12" y1="12" x2="12" y2="23" gradientUnits="userSpaceOnUse">
            <stop stop-color="#FDE68A"/>
            <stop offset="1" stop-color="#F59E0B"/>
          </linearGradient>
        </defs>
      </svg>
      <p class="text-xs text-amber-700 font-medium">
        <span class="font-bold text-sm">{currentStreak}</span> hari berturut-turut hadir
      </p>
    </div>
  )}

  {followUpCount > 0 && (
    <div
      class="mt-3 flex items-center gap-2 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5"
      role="note"
      aria-label={`${followUpCount} hari perlu ditindaklanjuti`}
    >
      <!-- Warning icon -->
      <svg
        class="w-4 h-4 text-amber-500 shrink-0"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
      </svg>
      <p class="text-xs text-amber-700 font-medium">
        {followUpCount} hari perlu ditindaklanjuti
      </p>
    </div>
  )}
</section>
