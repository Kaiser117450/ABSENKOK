---
import type { PortalScheduleEntry, PortalScheduleModel } from '../../lib/portal/schedule';

interface Props {
  schedule: PortalScheduleModel;
}

const { schedule } = Astro.props;

const weekSections = [
  {
    title: 'Minggu ini',
    ariaLabel: 'Jadwal minggu ini',
    entries: schedule.weekAssignments,
    emptyTitle: 'Belum ada jadwal',
    emptyMessage:
      'Jadwal minggu ini belum diterbitkan. Cek kembali setelah admin menerbitkan jadwal.',
    showEmptyState: true,
  },
  ...(schedule.nextWeekAssignments.length > 0
    ? [
        {
          title: 'Minggu depan',
          ariaLabel: 'Jadwal minggu depan',
          entries: schedule.nextWeekAssignments,
          emptyTitle: '',
          emptyMessage: '',
          showEmptyState: false,
        },
      ]
    : []),
];

const todayEntry = schedule.todayAssignment;

type EntryTone = 'default' | 'warning' | 'danger' | 'accent' | 'neutral';

function getEntryTone(entry: PortalScheduleEntry): EntryTone {
  switch (entry.strictPrimaryStatus) {
    case 'late':
    case 'overtime':
      return 'warning';
    case 'short_work':
    case 'excess_break':
    case 'absence':
    case 'belum_absen_pulang':
      return 'danger';
    case 'active_incomplete':
      return 'accent';
    default:
      break;
  }

  switch (entry.attendanceStatus) {
    case 'sakit':
    case 'izin':
    case 'cuti':
    case 'libur':
    case 'hadir_tanpa_jadwal':
      return 'neutral';
    default:
      return 'default';
  }
}

function getToneClasses(entry: PortalScheduleEntry) {
  switch (getEntryTone(entry)) {
    case 'warning':
      return {
        card: 'bg-amber-50 border-amber-200',
        title: 'text-amber-900',
        meta: 'text-amber-700',
        pill: 'bg-amber-100 text-amber-700',
      };
    case 'danger':
      return {
        card: 'bg-red-50 border-red-200',
        title: 'text-red-900',
        meta: 'text-red-700',
        pill: 'bg-red-100 text-red-700',
      };
    case 'accent':
      return {
        card: 'bg-[#E91E8C]/5 border-[#E91E8C]/25',
        title: 'text-gray-900',
        meta: 'text-gray-600',
        pill: 'bg-[#E91E8C]/10 text-[#E91E8C]',
      };
    case 'neutral':
      return {
        card: 'bg-gray-50 border-gray-200',
        title: 'text-gray-900',
        meta: 'text-gray-500',
        pill: 'bg-gray-100 text-gray-600',
      };
    default:
      return {
        card: 'bg-white border-[#E91E8C]/25',
        title: 'text-gray-900',
        meta: 'text-gray-500',
        pill: 'bg-[#E91E8C]/10 text-[#E91E8C]',
      };
  }
}

function getPrimaryTitle(entry: PortalScheduleEntry): string {
  if (entry.attendanceStatus === 'sakit') return 'Sakit';
  if (entry.attendanceStatus === 'izin') return 'Izin';
  if (entry.attendanceStatus === 'cuti') return 'Cuti';
  if (entry.attendanceStatus === 'libur' || entry.isDayOff) return 'Libur';
  if (entry.shiftBandLabel) return entry.shiftBandLabel;
  if (entry.strictOutcomeLabel) return entry.strictOutcomeLabel;
  return 'Tanpa jadwal';
}

function formatLogicalDate(logicalDate: string, format: 'weekday' | 'month'): string {
  const date = new Date(`${logicalDate}T00:00:00`);
  if (format === 'weekday') {
    return date.toLocaleDateString('id-ID', { weekday: 'short' });
  }

  return date.toLocaleDateString('id-ID', { month: 'short' });
}
---

<section class="mb-6">
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500">
    Jadwal hari ini
  </h2>

  {todayEntry ? (
    <div
      class={`${getToneClasses(todayEntry).card} rounded-2xl border p-5 shadow-sm`}
      role="region"
      aria-label="Jadwal hari ini"
    >
      <div class="mb-4 flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class={`text-lg font-bold ${getToneClasses(todayEntry).title}`}>
            {getPrimaryTitle(todayEntry)}
          </p>
          {todayEntry.outletName && (
            <p class={`mt-1 text-sm ${getToneClasses(todayEntry).meta}`}>
              {todayEntry.outletName}
            </p>
          )}
        </div>
        <span
          class={`${getToneClasses(todayEntry).pill} shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold`}
        >
          Hari ini
        </span>
      </div>

      <div class="space-y-2">
        {todayEntry.requiredHoursLabel && (
          <p class="text-sm font-semibold text-gray-900">{todayEntry.requiredHoursLabel}</p>
        )}
        {todayEntry.workedDisplayLabel && (
          <p class="text-sm text-gray-700">{todayEntry.workedDisplayLabel}</p>
        )}
        {todayEntry.comparisonDisplayLabel && (
          <p class="text-sm text-gray-700">{todayEntry.comparisonDisplayLabel}</p>
        )}
      </div>

      {todayEntry.strictOutcomeLabel && (
        <div class="mt-4">
          <span
            class={`${getToneClasses(todayEntry).pill} inline-flex rounded-full px-2.5 py-1 text-xs font-semibold`}
          >
            {todayEntry.strictOutcomeLabel}
          </span>
        </div>
      )}

      {todayEntry.helperCopy && (
        <p class="mt-3 text-sm leading-relaxed text-gray-600">{todayEntry.helperCopy}</p>
      )}

      {todayEntry.notes && (
        <p class="mt-2 text-xs italic text-gray-500">{todayEntry.notes}</p>
      )}

      {todayEntry.isCompatibilityMode && (
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2">
          <p class="text-xs font-semibold text-amber-700">Mode kompatibilitas aktif</p>
          <p class="mt-1 text-xs leading-relaxed text-amber-700">
            Sebagian hari payroll dihitung dari log absensi dan kontrak karena jadwal belum tersedia.
          </p>
        </div>
      )}
    </div>
  ) : (
    <div
      class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-400"
      role="status"
    >
      <p class="text-sm font-semibold text-gray-700">Belum ada jadwal</p>
      <p class="mt-1 text-sm text-gray-500">
        Jadwal minggu ini belum diterbitkan. Cek kembali setelah admin menerbitkan jadwal.
      </p>
    </div>
  )}
</section>

{weekSections.map((section) => (
  <section class={section.title === 'Minggu ini' ? '' : 'mt-8'}>
    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500">
      {section.title}
    </h2>

    {section.entries.length > 0 ? (
      <div class="space-y-3" role="list" aria-label={section.ariaLabel}>
        {section.entries.map((entry) => (
          <div
            class={`${getToneClasses(entry).card} flex items-start gap-3 rounded-2xl border p-4 shadow-sm`}
            role="listitem"
          >
            <div class="w-12 shrink-0 text-center pt-0.5">
              <p class={`text-xs font-semibold uppercase ${getToneClasses(entry).meta}`}>
                {formatLogicalDate(entry.logicalDate, 'weekday')}
              </p>
              <p class={`text-lg font-bold leading-none ${getToneClasses(entry).title}`}>
                {new Date(`${entry.logicalDate}T00:00:00`).getDate()}
              </p>
              <p class={`text-xs ${getToneClasses(entry).meta}`}>
                {formatLogicalDate(entry.logicalDate, 'month')}
              </p>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class={`text-sm font-semibold ${getToneClasses(entry).title}`}>
                  {getPrimaryTitle(entry)}
                </p>
                {entry.logicalDate === schedule.referenceDate && (
                  <span class="text-xs font-medium text-[#E91E8C]">Hari ini</span>
                )}
                {entry.strictOutcomeLabel && entry.attendanceStatus !== 'libur' && (
                  <span
                    class={`${getToneClasses(entry).pill} inline-flex rounded-full px-2 py-0.5 text-xs font-semibold`}
                  >
                    {entry.strictOutcomeLabel}
                  </span>
                )}
              </div>

              {entry.requiredHoursLabel && (
                <p class="mt-1 text-sm text-gray-700">{entry.requiredHoursLabel}</p>
              )}

              {entry.outletName && (
                <p class={`mt-1 text-xs ${getToneClasses(entry).meta}`}>{entry.outletName}</p>
              )}

              {entry.helperCopy && entry.logicalDate === schedule.referenceDate && (
                <p class="mt-2 text-xs leading-relaxed text-gray-600">{entry.helperCopy}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      section.showEmptyState && (
        <div
          class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-400"
          role="status"
        >
          <p class="text-sm font-semibold text-gray-700">{section.emptyTitle}</p>
          <p class="mt-1 text-sm text-gray-500">{section.emptyMessage}</p>
        </div>
      )
    )}
  </section>
))
