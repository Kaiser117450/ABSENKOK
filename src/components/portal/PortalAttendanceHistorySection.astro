---
/**
 * PortalAttendanceHistorySection — recent attendance history card list.
 *
 * Renders descending logical-day recap cards from the Phase 42 typed recap
 * model. One-column stacked phone-first layout — no table/grid treatment.
 *
 * Props:
 *   recentDays    — the `recentDays` slice from the recap model (up to 14 rows).
 *   referenceDate — ISO date "YYYY-MM-DD" used to highlight today's row.
 *
 * Scope guard:
 *   - does not add loading/empty/error states (reserved for Phase 44)
 *   - does not add follow-up-day badges or exception labels (reserved for Phase 44)
 *   - does not re-derive logical-day grouping or summary counts
 *   - no client framework or new dependencies
 */

import type { PortalRecapDay, AttendanceStatus } from '../../lib/portal/attendance-recap';

interface Props {
  recentDays: PortalRecapDay[];
  referenceDate: string;
}

const { recentDays, referenceDate } = Astro.props;

/** Format HH:MM from a numeric hour + minute pair. */
function fmt(hour: number, minute: number): string {
  return `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
}

/** Format an ISO timestamptz string to a short time display, e.g. "08:05". */
function fmtTs(isoTs: string | null): string | null {
  if (!isoTs) return null;
  const d = new Date(isoTs);
  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
}

function isToday(logicalDate: string): boolean {
  return logicalDate === referenceDate;
}

function hasRenderableScheduleTime(day: PortalRecapDay): boolean {
  return day.hasSchedule && !(
    day.startHour === 0 &&
    day.startMinute === 0 &&
    day.endHour === 0 &&
    day.endMinute === 0
  );
}

interface StatusStyle {
  badge: string;
  card: string;
  dayNumber: string;
  dayLabel: string;
  meta: string;
}

function getStatusStyle(status: AttendanceStatus, today: boolean): StatusStyle {
  switch (status) {
    case 'hadir':
      return {
        badge: 'bg-emerald-100 text-emerald-700',
        card: today ? 'bg-emerald-50 border-emerald-200' : 'bg-white border-gray-200',
        dayNumber: today ? 'text-emerald-700' : 'text-gray-700',
        dayLabel: today ? 'text-emerald-600' : 'text-gray-400',
        meta: 'text-gray-500',
      };
    case 'sakit':
      return {
        badge: 'bg-red-100 text-red-700',
        card: 'bg-red-50 border-red-200',
        dayNumber: 'text-red-700',
        dayLabel: 'text-red-600',
        meta: 'text-red-500',
      };
    case 'izin':
      return {
        badge: 'bg-sky-100 text-sky-700',
        card: 'bg-sky-50 border-sky-200',
        dayNumber: 'text-sky-700',
        dayLabel: 'text-sky-600',
        meta: 'text-sky-500',
      };
    case 'belum_pulang':
      return {
        badge: 'bg-amber-100 text-amber-700',
        card: today ? 'bg-amber-50 border-amber-200' : 'bg-white border-gray-200',
        dayNumber: today ? 'text-amber-700' : 'text-gray-700',
        dayLabel: today ? 'text-amber-600' : 'text-gray-400',
        meta: 'text-gray-500',
      };
    case 'sedang_bekerja':
      return {
        badge: 'bg-[#E91E8C]/10 text-[#E91E8C]',
        card: 'bg-[#E91E8C]/5 border-[#E91E8C]/20',
        dayNumber: 'text-[#E91E8C]',
        dayLabel: 'text-[#E91E8C]',
        meta: 'text-gray-500',
      };
    case 'tidak_hadir':
      return {
        badge: 'bg-red-100 text-red-700',
        card: 'bg-white border-gray-200',
        dayNumber: 'text-gray-700',
        dayLabel: 'text-gray-400',
        meta: 'text-gray-500',
      };
    case 'belum_masuk':
      return {
        badge: 'bg-gray-100 text-gray-500',
        card: today ? 'bg-[#E91E8C]/5 border-[#E91E8C]/20' : 'bg-white border-gray-200',
        dayNumber: today ? 'text-[#E91E8C]' : 'text-gray-700',
        dayLabel: today ? 'text-[#E91E8C]' : 'text-gray-400',
        meta: 'text-gray-500',
      };
    case 'libur':
      return {
        badge: 'bg-gray-100 text-gray-500',
        card: 'bg-gray-50 border-gray-200',
        dayNumber: 'text-gray-500',
        dayLabel: 'text-gray-400',
        meta: 'text-gray-400',
      };
    default:
      return {
        badge: 'bg-gray-100 text-gray-500',
        card: 'bg-white border-gray-200',
        dayNumber: 'text-gray-700',
        dayLabel: 'text-gray-400',
        meta: 'text-gray-500',
      };
  }
}

function getStatusLabel(status: AttendanceStatus): string {
  switch (status) {
    case 'hadir': return 'Hadir';
    case 'sakit': return 'Sakit';
    case 'izin': return 'Izin';
    case 'belum_pulang': return 'Belum Pulang';
    case 'sedang_bekerja': return 'Sedang Bekerja';
    case 'tidak_hadir': return 'Tidak Hadir';
    case 'belum_masuk': return 'Belum Masuk';
    case 'libur': return 'Libur';
    default: return '—';
  }
}
---

<section aria-label="Riwayat kehadiran terkini">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
    Riwayat Terkini
  </h2>

  {recentDays.length === 0 ? (
    <div class="bg-gray-50 rounded-2xl border border-dashed border-gray-300 p-6 text-center text-gray-400" role="status">
      <p class="text-sm font-medium">Belum ada data riwayat kehadiran</p>
    </div>
  ) : (
    <div class="space-y-3" role="list" aria-label="Daftar riwayat kehadiran">
      {recentDays.map((day) => {
        const today = isToday(day.logicalDate);
        const style = getStatusStyle(day.attendanceStatus, today);
        const masukTs = fmtTs(day.firstMasukAt);
        const pulangTs = fmtTs(day.lastPulangAt);
        const breakTs = fmtTs(day.firstBreakAt);
        const kembaliTs = fmtTs(day.lastKembaliAt);
        return (
          <div
            class={`${style.card} rounded-2xl border p-4 flex items-start gap-3 shadow-sm`}
            role="listitem"
          >
            <!-- Day indicator column -->
            <div class="w-12 shrink-0 text-center pt-0.5">
              <p class={`text-xs font-semibold uppercase ${style.dayLabel}`}>
                {new Date(day.logicalDate + 'T00:00:00').toLocaleDateString('id-ID', { weekday: 'short' })}
              </p>
              <p class={`text-lg font-bold leading-none ${style.dayNumber}`}>
                {new Date(day.logicalDate + 'T00:00:00').getDate()}
              </p>
              <p class={`text-xs ${style.dayLabel}`}>
                {new Date(day.logicalDate + 'T00:00:00').toLocaleDateString('id-ID', { month: 'short' })}
              </p>
            </div>

            <!-- Content column -->
            <div class="min-w-0 flex-1">
              <!-- Status badge + shift name row -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class={`${style.badge} text-xs font-semibold px-2 py-0.5 rounded-full shrink-0`}>
                  {getStatusLabel(day.attendanceStatus)}
                </span>
                {today && (
                  <span class="text-xs font-normal text-[#E91E8C]">Hari ini</span>
                )}
                {day.shiftName && !day.isDayOff && (
                  <span class="text-xs text-gray-500 truncate">{day.shiftName}</span>
                )}
              </div>

              <!-- Outlet and schedule time -->
              {(day.outletName || hasRenderableScheduleTime(day)) && (
                <p class={`text-xs mt-1 ${style.meta}`}>
                  {hasRenderableScheduleTime(day) && (
                    <span>
                      {fmt(day.startHour, day.startMinute)}&ndash;{fmt(day.endHour, day.endMinute)}
                      {day.endsNextDay && (
                        <span class="ml-1 text-amber-600 font-medium">(Selesai besok)</span>
                      )}
                    </span>
                  )}
                  {hasRenderableScheduleTime(day) && day.outletName && (
                    <span class="mx-1 text-gray-300">&middot;</span>
                  )}
                  {day.outletName && (
                    <span>{day.outletName}</span>
                  )}
                </p>
              )}

              <!-- Attendance timestamps -->
              {(masukTs || pulangTs) && (
                <div class={`mt-1.5 flex flex-wrap gap-x-3 gap-y-0.5 text-xs ${style.meta}`}>
                  {masukTs && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M13.8 12H3" />
                      </svg>
                      Masuk {masukTs}
                    </span>
                  )}
                  {pulangTs && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M19.8 12H9" />
                      </svg>
                      Pulang {pulangTs}
                    </span>
                  )}
                  {breakTs && (
                    <span class="flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 3v2M14 3v2M3 9h18M3 9a9 9 0 0 0 18 0" />
                      </svg>
                      Istirahat {breakTs}
                      {kembaliTs && <span>&ndash;{kembaliTs}</span>}
                    </span>
                  )}
                </div>
              )}

              <!-- Notes -->
              {day.notes && (
                <p class={`mt-1 text-xs italic ${style.meta}`}>{day.notes}</p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}
</section>
