---
import type { PortalRecapDay } from '../../lib/portal/attendance-recap';
import {
  getRecapDayPresentationForDay,
  type RecapDayTone,
} from '../../lib/portal/attendance-recap-presentation';

interface Props {
  recentDays: PortalRecapDay[];
  referenceDate: string;
}

const { recentDays, referenceDate } = Astro.props;

interface ToneStyle {
  badge: string;
  card: string;
  dayNumber: string;
  dayLabel: string;
  meta: string;
  followUpChip: string;
}

function getToneStyle(tone: RecapDayTone, today: boolean): ToneStyle {
  switch (tone) {
    case 'success':
      return {
        badge: 'bg-emerald-100 text-emerald-700',
        card: today ? 'bg-emerald-50 border-emerald-200' : 'bg-white border-gray-200',
        dayNumber: today ? 'text-emerald-700' : 'text-gray-700',
        dayLabel: today ? 'text-emerald-600' : 'text-gray-400',
        meta: 'text-gray-500',
        followUpChip: '',
      };
    case 'warning':
      return {
        badge: 'bg-amber-100 text-amber-700',
        card: 'bg-amber-50 border-amber-200',
        dayNumber: 'text-amber-700',
        dayLabel: 'text-amber-600',
        meta: 'text-amber-700',
        followUpChip: '',
      };
    case 'danger':
      return {
        badge: 'bg-red-100 text-red-700',
        card: 'bg-red-50 border-red-200',
        dayNumber: 'text-red-700',
        dayLabel: 'text-red-600',
        meta: 'text-red-700',
        followUpChip: 'border border-red-200 bg-red-100 text-red-700',
      };
    case 'accent':
      return {
        badge: 'bg-[#E91E8C]/10 text-[#E91E8C]',
        card: today ? 'bg-[#E91E8C]/5 border-[#E91E8C]/20' : 'bg-white border-gray-200',
        dayNumber: today ? 'text-[#E91E8C]' : 'text-gray-700',
        dayLabel: today ? 'text-[#E91E8C]' : 'text-gray-400',
        meta: 'text-gray-500',
        followUpChip: '',
      };
    case 'neutral':
    default:
      return {
        badge: 'bg-gray-100 text-gray-600',
        card: 'bg-gray-50 border-gray-200',
        dayNumber: 'text-gray-700',
        dayLabel: 'text-gray-400',
        meta: 'text-gray-500',
        followUpChip: '',
      };
  }
}

function isToday(logicalDate: string): boolean {
  return logicalDate === referenceDate;
}

function formatDay(logicalDate: string, format: 'weekday' | 'month'): string {
  const date = new Date(`${logicalDate}T00:00:00`);
  if (format === 'weekday') {
    return date.toLocaleDateString('id-ID', { weekday: 'short' });
  }

  return date.toLocaleDateString('id-ID', { month: 'short' });
}

function formatTimestamp(isoValue: string | null): string | null {
  if (!isoValue) return null;
  const date = new Date(isoValue);
  return `${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}`;
}
---

<section aria-label="Riwayat kehadiran terkini">
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500">
    Riwayat Terkini
  </h2>

  {recentDays.length === 0 ? (
    <div
      class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-400"
      role="status"
    >
      <p class="text-sm font-medium">Belum ada data riwayat kehadiran</p>
    </div>
  ) : (
    <div class="space-y-3" role="list" aria-label="Daftar riwayat kehadiran">
      {recentDays.map((day) => {
        const today = isToday(day.logicalDate);
        const presentation = getRecapDayPresentationForDay(day, referenceDate);
        const style = getToneStyle(presentation.tone, today);
        const masukAt = formatTimestamp(day.firstMasukAt);
        const pulangAt = formatTimestamp(day.lastPulangAt);
        const breakAt = formatTimestamp(day.firstBreakAt);
        const kembaliAt = formatTimestamp(day.lastKembaliAt);

        return (
          <div
            class={`${style.card} flex items-start gap-3 rounded-2xl border p-4 shadow-sm`}
            role="listitem"
          >
            <div class="w-12 shrink-0 text-center pt-0.5">
              <p class={`text-xs font-semibold uppercase ${style.dayLabel}`}>
                {formatDay(day.logicalDate, 'weekday')}
              </p>
              <p class={`text-lg font-bold leading-none ${style.dayNumber}`}>
                {new Date(`${day.logicalDate}T00:00:00`).getDate()}
              </p>
              <p class={`text-xs ${style.dayLabel}`}>{formatDay(day.logicalDate, 'month')}</p>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class={`${style.badge} inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold`}
                >
                  {presentation.label}
                </span>
                {today && (
                  <span class="text-xs font-medium text-[#E91E8C]">Hari ini</span>
                )}
              </div>

              {presentation.needsFollowUp && presentation.followUpLabel && (
                <div
                  class={`mt-2 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${style.followUpChip}`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                    />
                  </svg>
                  {presentation.followUpLabel}
                </div>
              )}

              {day.attendanceStatus !== 'libur' && (day.shiftBandLabel || day.requiredHoursLabel) && (
                <p class="mt-2 text-sm text-gray-700">
                  {[day.shiftBandLabel, day.requiredHoursLabel]
                    .filter(Boolean)
                    .join(' • ')}
                </p>
              )}

              {day.attendanceStatus !== 'libur' && (day.workedDisplayLabel || day.comparisonDisplayLabel) && (
                <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm text-gray-700">
                  {day.workedDisplayLabel && <span>{day.workedDisplayLabel}</span>}
                  {day.comparisonDisplayLabel && <span>{day.comparisonDisplayLabel}</span>}
                </div>
              )}

              {day.attendanceStatus !== 'libur' && (masukAt || pulangAt || breakAt) && (
                <div class={`mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs ${style.meta}`}>
                  {masukAt && <span>Masuk {masukAt}</span>}
                  {pulangAt && <span>Pulang {pulangAt}</span>}
                  {breakAt && (
                    <span>
                      Istirahat {breakAt}
                      {kembaliAt && ` - ${kembaliAt}`}
                    </span>
                  )}
                </div>
              )}

              {presentation.supportingCopy && (
                <p class="mt-2 text-sm leading-relaxed text-gray-600">
                  {presentation.supportingCopy}
                </p>
              )}

              {day.outletName && (
                <p class={`mt-2 text-xs ${style.meta}`}>{day.outletName}</p>
              )}

              {day.notes && (
                <p class={`mt-1 text-xs italic ${style.meta}`}>{day.notes}</p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}
</section>
