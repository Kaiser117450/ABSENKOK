<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded view: shown when notification is pulled down -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_pill_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Row 1: Icon + Outlet name + Clock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_exp_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="centerInside"
            android:contentDescription="Absensi Enakko"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_exp_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kiosk Aktif"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/notif_exp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Absensi NFC Aktif"
                android:textColor="#AEAEB2"
                android:textSize="12sp"
                android:maxLines="1"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/notif_exp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#4ADE80"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="#4ADE80"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#333333"/>

    <!-- Row 2: Status info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 NFC Siap"
            android:textColor="#8E8E93"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/notif_exp_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Aktif"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
