<?xml version="1.0" encoding="utf-8"?>
<!--
  Universal NFC tech filter.
  Supports ALL card types: e-KTP, e-Toll, Flazz, bank cards, Mifare, ISO-DEP, etc.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- ISO 14443-A: e-KTP, e-Money, many bank cards -->
    <tech-list>
        <tech>android.nfc.tech.NfcA</tech>
    </tech-list>

    <!-- ISO 14443-B: some bank cards, passports -->
    <tech-list>
        <tech>android.nfc.tech.NfcB</tech>
    </tech-list>

    <!-- ISO 15693: some access cards -->
    <tech-list>
        <tech>android.nfc.tech.NfcV</tech>
    </tech-list>

    <!-- JIS 6319-4 (FeliCa): Flazz BCA, some transit cards -->
    <tech-list>
        <tech>android.nfc.tech.NfcF</tech>
    </tech-list>

    <!-- ISO-DEP: smart cards, some bank cards -->
    <tech-list>
        <tech>android.nfc.tech.IsoDep</tech>
    </tech-list>

    <!-- Mifare Classic: e-Toll, building access cards -->
    <tech-list>
        <tech>android.nfc.tech.MifareClassic</tech>
    </tech-list>

    <!-- Mifare Ultralight: cheaper cards, some event tickets -->
    <tech-list>
        <tech>android.nfc.tech.MifareUltralight</tech>
    </tech-list>

    <!-- NDEF: formatted tags with data -->
    <tech-list>
        <tech>android.nfc.tech.Ndef</tech>
    </tech-list>

    <!-- NDEF Formatable: blank tags -->
    <tech-list>
        <tech>android.nfc.tech.NdefFormatable</tech>
    </tech-list>
</resources>
